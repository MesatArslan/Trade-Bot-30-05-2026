      <div id="planArmed" class="armedbar"></div>
      <div class="plan-wrap">
        <div class="plan-main">
          <div style="overflow-x:auto">
          <table class="ftable ptable"><thead><tr>
            <th>#</th><th>Coin</th><th>Yön</th><th>Giriş<br><span class="muted">üstünde kapanışta al</span></th>
            <th>Stop</th><th>Hedef 1</th><th>Hedef 2</th>
            <th>Direnç noktaları</th>
            <th>En iyi giriş<br><span class="muted">1dk retest alarmı</span></th></tr></thead>
            <tbody id="planRows">
              <tr><td colspan="9" class="muted">Henüz tarama yok — <b>Tara</b>'ya bas.</td></tr>
            </tbody></table>
          </div>
          <div class="hint" style="margin-top:14px">Kural: Giriş üstünde 15dk mum kapanınca LONG aç, hemen
            <b>Stop</b>'u koy. <b>Hedef 1</b>'de yarını sat + stop'u girişe çek. Kalan yarı <b>Hedef 2</b>'ye
            koşsun. Aynı anda max 2 pozisyon.</div>
        </div>
        <div class="plan-side">
          <div class="col-h" style="margin-bottom:8px">🕘 Geçmiş taramalar</div>
          <div id="planHistory" class="phist"><div class="muted" style="font-size:12px">—</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ RETEST DÖNÜŞ · kırdı + retest yaptı + şu an yukarı ═══ -->
  <div class="tab-panel" id="tab-retest">
    <div class="card reveal">
      <div class="row" style="justify-content:space-between;align-items:flex-start">
        <div style="max-width:660px">
          <div class="card-t"><span class="n">🚀</span> Direnç kırdı · ŞU AN direncini kırmış coinler</div>
          <div class="hint" style="margin-top:9px">Bybit'te <b>şu an bir direnci kırmış</b> ve fiyat hâlâ
            seviyenin üstünde (henüz %8'den fazla uzamamış) coinler (5dk yapı). Durum kolonunda
            <b>retest yaptı mı</b> ve <b>yukarı dönüyor mu</b> görünür — retest'i tamamlayıp yükselenler
            skorla en üste çıkar. Satıra tıkla → Bybit grafiği.</div>
        </div>
        <button class="mini" id="retestBtn" onclick="loadRetest()" style="font-weight:700">↻ Yenile</button>
      </div>
      <div id="retestStatus" class="statusline"></div>
      <div style="overflow-x:auto">
      <table class="ftable ptable"><thead><tr>
        <th>#</th><th>Coin</th><th>Fiyat</th>
        <th>Seviye<br><span class="muted">kırılan direnç</span></th>
        <th>Giriş<br><span class="muted">şu an</span></th>
        <th>Stop</th><th>Hedef 1</th><th>Hedef 2</th>
        <th>Durum<br><span class="muted">kırılım · retest · hacim</span></th></tr></thead>
        <tbody id="retestRows">
          <tr><td colspan="9" class="muted">Yükleniyor…</td></tr>
        </tbody></table>
      </div>
      <div class="hint" style="margin-top:14px">Kural: Seviye retest'te tuttu ve yukarı dönüyor →
        <b>Giriş</b> civarında LONG, <b>Stop</b>'u retest dibinin altına koy. <b>Hedef 1</b>'de yarını
        sat + stop'u girişe çek. Fiyat seviyeden %8'den fazla uzaklaşmışsa kovalama (liste zaten eler).</div>
    </div>
  </div>

  <!-- ═══ SHORT PLAN · DESTEK / KIRILIM (araştırma) ═══ -->
  <div class="tab-panel" id="tab-splan">
    <div class="card reveal">
      <div class="row" style="justify-content:space-between;align-items:flex-start">
        <div style="max-width:660px">
          <div class="card-t"><span class="n">📉</span> Destek / kırılım planı · SHORT · sen çağırınca çalışır</div>
          <div class="hint" style="margin-top:9px"><b>Tara</b>'ya bas → düşen trendde bir
            <b>destek seviyesini test eden</b> SHORT adayları çıkar. Her biri için
            <b>giriş · stop · hedef1 · hedef2 · destek noktaları</b>. Giriş kuralı:
            <b>o seviyenin altında 15dk mum kapanınca short aç</b> — anlık dokunuşta değil. Her tarama
            <b>saatiyle kaydedilir</b>; sağdaki geçmişten eskilerine bakabilirsin.</div>
        </div>
        <button class="mini" id="splanScanBtn" onclick="runSPlan()" style="font-weight:700">⟳ Tara</button>
      </div>
      <div id="splanStatus" class="statusline"></div>
      <div class="plan-wrap">
        <div class="plan-main">
          <div style="overflow-x:auto">
          <table class="ftable ptable"><thead><tr>
            <th>#</th><th>Coin</th><th>Yön</th><th>Giriş<br><span class="muted">altında kapanışta sat</span></th>
            <th>Stop</th><th>Hedef 1</th><th>Hedef 2</th>
            <th>Destek noktaları</th></tr></thead>
            <tbody id="splanRows">
              <tr><td colspan="8" class="muted">Henüz tarama yok — <b>Tara</b>'ya bas.</td></tr>
            </tbody></table>
          </div>
          <div class="hint" style="margin-top:14px">Kural: Giriş altında 15dk mum kapanınca SHORT aç, hemen
            <b>Stop</b>'u koy. <b>Hedef 1</b>'de yarını kapat + stop'u girişe çek. Kalan yarı <b>Hedef 2</b>'ye
            düşsün. Aynı anda max 2 pozisyon.</div>
        </div>
        <div class="plan-side">
          <div class="col-h" style="margin-bottom:8px">🕘 Geçmiş taramalar</div>
          <div id="splanHistory" class="phist"><div class="muted" style="font-size:12px">—</div></div>
        </div>
      </div>
    </div>
  </div>


  <div class="footer-note">
    Bu araç sinyal verir; emri MEXC'te sen açarsın. Otomatik işlem yapmaz.
  </div>
</div>

<script>
const $ = s => document.querySelector(s);
const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* MEXC'i tam ekrana yakın BÜYÜK pencerede açar (TEK çağrı — çift açma yok) */
function openMexc(url){
  const w = (window.screen && screen.availWidth)  || window.innerWidth  || 1600;
  const h = (window.screen && screen.availHeight) || window.innerHeight || 900;
  // noopener YOK → win handle'ı alırız; tek window.open çağrısı → gesture tükenmez
  const win = window.open(url, '_blank', `width=${w},height=${h},left=0,top=0`);
  try{ if(win){ win.moveTo(0,0); win.resizeTo(w,h); win.focus(); } }catch(e){}
  return win;
}
/* Aynı tarayıcı penceresinde YENİ SEKME açar (popup değil) — boyut parametresi
   verilmeyince tarayıcı yeni sekme açar. Bot kartları bunu kullanır. */
function openMexcTab(url){
  const win = window.open(url, '_blank');
  try{ if(win) win.focus(); }catch(e){}
  return win;
}
const HAS_GSAP = typeof gsap !== 'undefined';
const HAS_LENIS = typeof Lenis !== 'undefined';
let nextSettleMs = 0;

/* ═══════════ MOTION KATMANI (graceful — CDN yoksa atlanır) ═══════════ */
// Lenis smooth scroll + GSAP ticker
try{
  if(HAS_LENIS && !RM){
    const lenis = new Lenis({duration:1.1,easing:t=>Math.min(1,1.001-Math.pow(2,-10*t)),
      smoothWheel:true});
    if(HAS_GSAP){
      gsap.ticker.add(t=>lenis.raf(t*1000));
      gsap.ticker.lagSmoothing(0);
      if(gsap.registerPlugin && typeof ScrollTrigger!=='undefined'){
        gsap.registerPlugin(ScrollTrigger);
        lenis.on('scroll', ScrollTrigger.update);
      }
    }else{
      const raf=t=>{lenis.raf(t);requestAnimationFrame(raf)};requestAnimationFrame(raf);
    }
  }
}catch(e){}

// giriş reveal
try{
  if(HAS_GSAP && !RM){
    gsap.set('.reveal',{opacity:0,y:24});
    gsap.to('.reveal',{opacity:1,y:0,duration:1,ease:'expo.out',stagger:.09,delay:.15});
  }else{
    document.querySelectorAll('.reveal').forEach(el=>{el.style.opacity=1;el.style.transform='none'});
  }
}catch(e){document.querySelectorAll('.reveal').forEach(el=>{el.style.opacity=1;el.style.transform='none'});}

// entrance yardımcısı (yeni render olan içeriğe)
function enter(sel,parent){
  if(!HAS_GSAP||RM) return;
  const els=(parent||document).querySelectorAll(sel);
  if(els.length) gsap.fromTo(els,{opacity:0,y:18},
    {opacity:1,y:0,duration:.7,ease:'power3.out',stagger:.06,overwrite:true});
}

/* ═══════════ saat + geri sayım ═══════════ */
function tickClock(){
  const now = new Date();
  const tr = new Date(now.getTime() + (now.getTimezoneOffset()+180)*60000);
  $('#clock').textContent = tr.toLocaleTimeString('tr-TR');
  if(nextSettleMs){
    let s = Math.floor((nextSettleMs - Date.now())/1000);
    if(s < 0) s = 0;
    const h=Math.floor(s/3600), m=Math.floor(s%3600/60), ss=s%60;
    const pad=n=>String(n).padStart(2,'0');
    $('#cd').textContent = (h? h+':':'') + pad(m)+':'+pad(ss);
    const cd=$('#cd');
    if(s<=60 && s>0){cd.style.color='var(--red)';cd.style.textShadow='0 0 16px rgba(255,84,112,.5)';}
    else{cd.style.color='var(--amb)';cd.style.textShadow='0 0 14px rgba(255,193,72,.35)';}
  }
}
/* ═══════════ görünürlük yönetimi — arka planda polling'i durdur (Safari bellek koruması) ═══════════ */
let PAGE_HIDDEN = document.visibilityState === 'hidden';
const _pollFns = [];
// görünür değilken tetikleme; sekme geri gelince bir kez hemen tazele
function poll(fn, ms){
  _pollFns.push(fn);
  return setInterval(()=>{ if(!PAGE_HIDDEN){ try{ fn(); }catch(e){} } }, ms);
}
document.addEventListener('visibilitychange', ()=>{
  PAGE_HIDDEN = document.visibilityState === 'hidden';
  if(!PAGE_HIDDEN){ _pollFns.forEach(f=>{ try{ f(); }catch(e){} }); }
});

poll(tickClock, 1000);

async function loadSchedule(){
  try{
    const r = await (await fetch('/api/schedule')).json();
    nextSettleMs = r.next_settle_ms || 0;
    $('#settle').textContent = r.next_settle_tr || '—';
  }catch(e){}
}
loadSchedule(); poll(loadSchedule, 30000);

/* ═══════════ funding lider tablosu (heatmap) ═══════════ */
function fnum(n){
  if(n===null||n===undefined) return '<span class="muted">—</span>';
  const c = n>0?'fpos':(n<0?'fneg':'');
  return `<span class="${c}">${(n*100).toFixed(4)}%</span>`;
}
function frow(x, i, maxAbs, positive){
  const dot = x.agree===null?'<span class="dot no"></span>'
            : x.agree?'<span class="dot ok"></span>':'<span class="dot no"></span>';
  // heatmap bar — funding büyüklüğüne göre
  const mag = maxAbs? Math.min(1, Math.abs(x.funding||0)/maxAbs) : 0;
  const w = (mag*100).toFixed(0);
  const col = positive
    ? `linear-gradient(90deg,rgba(47,224,138,${.05+mag*.22}),rgba(47,224,138,${.02}))`
    : `linear-gradient(90deg,rgba(255,84,112,${.05+mag*.22}),rgba(255,84,112,${.02}))`;
  return `<tr>
    <td><span class="coin"><span class="rank">${String(i+1).padStart(2,'0')}</span>${x.symbol.replace('_USDT','')}${dot}</span></td>
    <td class="heat"><span class="bar" style="width:${w}%;background:${col}"></span><span class="val">${fnum(x.funding)}</span></td>
    <td>${fnum(x.binance_funding)}</td>
    <td>$${(x.oi_usd/1e6).toFixed(1)}M</td></tr>`;
}
let fundLoading=false;
async function loadFunding(){
  if(fundLoading) return;
  fundLoading=true;
  $('#fundStatus').innerHTML='<span class="spinner"></span> Yükleniyor...';
  try{
    const r = await (await fetch('/api/funding')).json();
    const pos=r.positive||[], neg=r.negative||[];
    const maxP=Math.max(0,...pos.map(x=>Math.abs(x.funding||0)));
    const maxN=Math.max(0,...neg.map(x=>Math.abs(x.funding||0)));
    $('#fpos').innerHTML = pos.map((x,i)=>frow(x,i,maxP,true)).join('') ||
      '<tr><td colspan="4" class="muted">yok</td></tr>';
    $('#fneg').innerHTML = neg.map((x,i)=>frow(x,i,maxN,false)).join('') ||
      '<tr><td colspan="4" class="muted">yok</td></tr>';
    $('#fundStatus').innerHTML =
      `<span class="stat-chip hi">${r.count} likit coin</span>` +
      `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#fpos tr, #fneg tr');
  }catch(e){ $('#fundStatus').textContent='Hata: '+e; }
  fundLoading=false;
}

/* ═══════════ squeeze adayları (SKR profili) ═══════════ */
let sqLoading=false;
function sqCard(r){
  const s=r.symbol.replace('USDT','');
  const ph={fresh:['sq-fresh','⏳ TAZE KURULUM'],mid:['sq-mid','🔶 ORTA'],late:['sq-late','🚀 UÇTU / GEÇ']}[r.phase];
  const trTxt={worsening:'↓ kötüleşiyor',negative:'↓ negatif',mixed:'karışık'}[r.trend]||r.trend;
  const seq=(r.vals||[]).slice(0,4).reverse().map(v=>(v*100).toFixed(2)).join('  ·  ');
  const frCls=r.funding<0?'neg':'pos', pcCls=r.pc24<0?'neg':'pos';
  const link=r.mexc_sym
    ? `https://futures.mexc.com/exchange/${r.mexc_sym}`
    : `https://www.bybit.com/trade/usdt/${r.symbol}`;
  const exTag=r.mexc_sym?'':`<span class="sq-tag sq-late" style="margin-left:4px">sadece Bybit</span>`;
  return `<div class="sq-card" onclick="openMexc('${link}')">
    <div class="sq-top"><span class="sq-sym">${s}</span><span class="sq-tr"><button class="watchbtn" onclick="event.stopPropagation();watchSignal('${s}','AL','🔥 Squeeze')">📈 Sinyal</button><span class="sq-tag ${ph[0]}">${ph[1]}</span>${exTag}</span></div>
    <div class="sq-rows">
      <span class="k">Funding</span><span class="v ${frCls}">${(r.funding*100).toFixed(2)}%</span>
      <span class="k">24s değişim</span><span class="v ${pcCls}">${(r.pc24*100).toFixed(0)}%</span>
      <span class="k">Open Interest</span><span class="v">$${(r.oi_usd/1e6).toFixed(1)}M</span>
      <span class="k">24s hacim</span><span class="v">$${(r.vol24/1e6).toFixed(0)}M</span>
      <span class="k">Trend</span><span class="v">${trTxt}</span>
      <span class="k">Yaş / tazelik</span><span class="v">${r.age_days==null?'?':r.age_days+'g'} · ${r.fresh}</span>
    </div>
    <div class="sq-foot">funding dizisi (eski→yeni): ${seq}</div>
  </div>`;
}
async function loadSqueeze(){
  if(sqLoading) return; sqLoading=true;
  $('#sqStatus').innerHTML='<span class="spinner"></span> Bybit taranıyor...';
  try{
    const r=await (await fetch('/api/squeeze')).json();
    const c=r.candidates||[];
    $('#sqGrid').innerHTML = c.length? c.map(sqCard).join('')
      : '<div class="muted" style="padding:30px">Şu an SKR profiline uyan aday yok — sistem her funding saatinde değişir.</div>';
    $('#sqStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.count} aday</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#sqGrid .sq-card');
  }catch(e){ $('#sqStatus').textContent='Hata: '+e; }
  sqLoading=false;
}

/* ═══════════ patlamış / tükeniş (short adayları) ═══════════ */
let pumpLoading=false;
function pumpCard(r){
  const s=r.symbol.replace('USDT','');
  const ph={rolling:['sq-late','🔻 DÖNÜYOR'],topping:['sq-mid','🔶 TEPEDE'],running:['sq-fresh','⚡ FIRLIYOR']}[r.phase];
  const sign=n=>(n>0?'+':'')+(n*100).toFixed(1)+'%';
  const cls=n=>n<0?'neg':'pos';
  const mexc=r.symbol.replace(/USDT$/,'_USDT');
  return `<div class="sq-card" onclick="openMexc('https://futures.mexc.com/exchange/${mexc}')">
    <div class="sq-top"><span class="sq-sym">${s}</span><span class="sq-tr"><button class="watchbtn" onclick="event.stopPropagation();watchSignal('${s}','${r.phase==='running'?'AL':r.phase==='rolling'?'SAT':''}','💥 Patlamış')">📈 Sinyal</button><span class="sq-tag ${ph[0]}">${ph[1]}</span></span></div>
    <div class="sq-rows">
      <span class="k">Son 15dk</span><span class="v ${cls(r.m15)}">${sign(r.m15)}</span>
      <span class="k">Son 30dk</span><span class="v ${cls(r.m30)}">${sign(r.m30)}</span>
      <span class="k">Son 1s</span><span class="v ${cls(r.h1)}">${sign(r.h1)}</span>
      <span class="k">Hacim patlaması</span><span class="v">${r.vspike.toFixed(1)}x</span>
      <span class="k">1s tepeden ↓</span><span class="v neg">-${(r.fade*100).toFixed(1)}%</span>
      <span class="k">24s toplam</span><span class="v ${cls(r.pc24)}">${sign(r.pc24)}</span>
      <span class="k">24s hacim</span><span class="v">$${(r.vol24/1e6).toFixed(0)}M</span>
      <span class="k">Funding</span><span class="v ${r.funding<0?'neg':'pos'}">${(r.funding*100).toFixed(3)}%</span>
    </div>
    <div class="sq-foot">skor ${r.score} · ⚡ firliyorsa momentum-long / 🔻 dönüyorsa short — teyit + dar stop</div>
  </div>`;
}
async function loadPump(){
  if(pumpLoading) return; pumpLoading=true;
  $('#pumpStatus').innerHTML='<span class="spinner"></span> Bybit taranıyor... (pump + kline)';
  try{
    const r=await (await fetch('/api/pump')).json();
    const c=r.candidates||[];
    $('#pumpGrid').innerHTML = c.length? c.map(pumpCard).join('')
      : '<div class="muted" style="padding:30px">Şu an +%15 üstü pump yapmış coin yok — piyasa sakin.</div>';
    $('#pumpStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.count} patlamış coin</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#pumpGrid .sq-card');
  }catch(e){ $('#pumpStatus').textContent='Hata: '+e; }
  pumpLoading=false;
}

/* ═══════════ trend scalp (şu an koşan trend · long + short) ═══════════ */
let trendLoading=false;
function trendCard(r){
  const s=r.symbol.replace('USDT','');
  const isL=r.side==='LONG';
  const tag=isL?['sq-fresh','🟢 LONG']:['sq-late','🔴 SHORT'];
  const sign=n=>(n>0?'+':'')+(n*100).toFixed(1)+'%';
  const cls=n=>n<0?'neg':'pos';
  const pf=n=>{ n=+n; return n>=1?n.toLocaleString('en-US',{maximumFractionDigits:4})
                                 :n.toPrecision(4); };
  const mexc=r.symbol.replace(/USDT$/,'_USDT');
  const url=`https://futures.mexc.com/exchange/${mexc}`
    +`#ft_amt=5&ft_tp=${r.tp1}&ft_cls=80&ft_side=${isL?'long':'short'}`;
  return `<div class="sq-card" onclick="openMexc('${url}')">
    <div class="sq-top"><span class="sq-sym">${s}</span><span class="sq-tr"><button class="watchbtn" onclick="event.stopPropagation();watchSignal('${s}','${isL?'AL':'SAT'}','⚡ Trend Scalp')">📈 Sinyal</button><span class="sq-tag ${tag[0]}">${tag[1]}</span></span></div>
    <div class="sq-rows">
      <span class="k">Son 15dk</span><span class="v ${cls(r.m15)}">${sign(r.m15)}</span>
      <span class="k">Son 30dk</span><span class="v ${cls(r.m30)}">${sign(r.m30)}</span>
      <span class="k">Son 1s</span><span class="v ${cls(r.h1)}">${sign(r.h1)}</span>
      <span class="k">Hacim</span><span class="v">${r.vspike.toFixed(1)}x</span>
      <span class="k">Oynaklık (ATR)</span><span class="v">${r.atr_pct.toFixed(2)}%</span>
      <span class="k">24s hacim</span><span class="v">$${(r.vol24/1e6).toFixed(0)}M</span>
    </div>
    <div class="tr-plan">
      <span class="k">Giriş</span><span class="v">${pf(r.entry)}</span>
      <span class="k">Stop</span><span class="v stp">${pf(r.stop)} · -${r.stop_pct}%</span>
      <span class="k">Hedef 1</span><span class="v tgt">${pf(r.tp1)} · +${r.tp1_pct}%</span>
      <span class="k">Hedef 2</span><span class="v tgt">${pf(r.tp2)} · +${r.tp2_pct}%</span>
    </div>
    <div class="sq-foot">skor ${r.score} · giriş = anlık piyasa · 15-20 dk vur-çık</div>
  </div>`;
}
async function loadTrend(){
  if(trendLoading) return; trendLoading=true;
  $('#trendStatus').innerHTML='<span class="spinner"></span> Bybit taranıyor... (trend + kline)';
  try{
    const r=await (await fetch('/api/trend')).json();
    const c=r.candidates||[];
    $('#trendGrid').innerHTML = c.length? c.map(trendCard).join('')
      : '<div class="muted" style="padding:30px">Şu an net trendde koşan coin yok — piyasa yönsüz/sıkışık. Birazdan tekrar dene.</div>';
    $('#trendStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.count} trend adayı</span>`+
        `<span class="stat-chip" style="color:var(--grn)">🟢 ${r.longs||0} long</span>`+
        `<span class="stat-chip" style="color:var(--red)">🔴 ${r.shorts||0} short</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#trendGrid .sq-card');
  }catch(e){ $('#trendStatus').textContent='Hata: '+e; }
  trendLoading=false;
}

/* ═══════════ EMA50 + StochRSI tarayıcı ═══════════ */
let esLoading=false, esTf='15';
function esCard(r){
  const s=r.symbol.replace('USDT','');
  const isL=r.side==='LONG';
  const tag=isL?['sq-fresh','🟢 AL']:['sq-late','🔴 SHORT'];
  const cls=n=>n<0?'neg':'pos';
  const pf=n=>{ if(n==null) return '—'; n=+n; return n>=1?n.toLocaleString('en-US',{maximumFractionDigits:6})
                                 :n.toPrecision(4); };
  const mexc=r.symbol.replace(/USDT$/,'_USDT');
  const url=`https://futures.mexc.com/exchange/${mexc}`
    +`#ft_amt=5&ft_tp=${r.tp1}&ft_cls=80&ft_side=${isL?'long':'short'}`;
  const kcol=r.k<30?'#2fe08a':r.k>70?'#ff5470':'#a9b6d6';
  const crossBadge = r.cross!=='none'
    ? `<span class="sq-tag sq-fresh" style="background:rgba(47,224,138,.14);color:#2fe08a">✚ Kesişim</span>` : '';
  // KADEME rozeti (backtest bucket beklentisi): A=trend uyumlu+kesişim (tek artı
  // beklenti), B=trend uyumlu/teyit zayıf, C=ters-trend (negatif beklenti, dikkat)
  const gr=r.grade||'B';
  const gInfo={A:['#2fe08a','A · trend+kesişim'],B:['#f5c451','B · trend uyumlu'],
               C:['#ff5470','C · ters-trend ⚠']}[gr]||['#a9b6d6',gr];
  const gradeBadge=`<span class="sq-tag" style="background:${gInfo[0]}22;color:${gInfo[0]};font-weight:800" title="Kalite kademesi (backtest): A en iyi beklenti, C ters-trend uyarısı">🏅 ${gInfo[1]}</span>`;
  const kar = r.kar!=null ? r.kar : r.tp2_pct;
  // Kar potansiyeli rozeti: yüksek = daha hareketli fırsat (liste kar'a göre sıralı)
  const karCol = kar>=6?'#2fe08a':kar>=3?'#f5c451':'#a9b6d6';
  const karBadge = kar!=null
    ? `<span class="sq-tag" style="background:rgba(245,196,81,.14);color:${karCol};font-weight:800">💰 +${kar}%</span>` : '';
  return `<div class="sq-card" onclick="openMexc('${url}')">
    <div class="sq-top"><span class="sq-sym">${s}</span><span class="sq-tr">${gradeBadge}${karBadge}${crossBadge}<button class="watchbtn" onclick="event.stopPropagation();watchSignal('${s}','${isL?'AL':'SAT'}','🚀 Direnç Kırdı')">📈 Sinyal</button><span class="sq-tag ${tag[0]}">${tag[1]}</span></span></div>
    <div class="sq-rows">
      <span class="k">Fiyat</span><span class="v">${pf(r.price)}</span>
      <span class="k">EMA50</span><span class="v">${pf(r.ema50)}</span>
      ${r.aligned!=null?`<span class="k">Trend uyumu (EMA200)</span><span class="v" style="color:${r.aligned?'#2fe08a':'#ff5470'};font-weight:800">${r.aligned?'✔ uyumlu':'✖ ters-trend'}${r.trend?' · '+(r.trend==='up'?'üst-trend ▲':'alt-trend ▼'):''}</span>`:''}
      <span class="k">EMA'ya uzaklık</span><span class="v ${cls(r.dist_ema)}">${r.dist_ema>0?'+':''}${r.dist_ema}%</span>
      <span class="k">StochRSI %K</span><span class="v" style="color:${kcol};font-weight:800">${r.k}</span>
      <span class="k">StochRSI %D</span><span class="v">${r.d}</span>
      <span class="k">RSI(14)</span><span class="v">${r.rsi}</span>
      ${r.adx!=null?`<span class="k">ADX (trend gücü)</span><span class="v" style="color:${r.adx>=28?'#2fe08a':r.adx>=22?'#f5c451':'#a9b6d6'};font-weight:800">${r.adx}${r.adx>=28?' güçlü':''}</span>`:''}
      <span class="k">24s hacim</span><span class="v">$${(r.vol24/1e6).toFixed(0)}M</span>
    </div>
    <div class="tr-plan">
      <span class="k">Giriş</span><span class="v">${pf(r.entry)}</span>
      <span class="k">Stop</span><span class="v stp">${pf(r.stop)} · -${r.stop_pct}%</span>
      <span class="k">Hedef 1</span><span class="v tgt">${pf(r.tp1)} · +${r.tp1_pct}%</span>
      <span class="k">Hedef 2</span><span class="v tgt">${pf(r.tp2)} · +${r.tp2_pct}%</span>
    </div>
    <div class="sq-foot">💰 kâr pot. +${kar}% · kalite ${r.q!=null?r.q+'/100':r.score} · ${esTf==='240'?'4sa':esTf==='60'?'1sa':esTf+'dk'} grafik · EMA50 + StochRSI kurulumu</div>
  </div>`;
}
async function loadEmaStoch(){
  if(esLoading) return; esLoading=true;
  $('#esStatus').innerHTML='<span class="spinner"></span> Bybit taranıyor... (EMA50 + StochRSI)';
  try{
    const r=await (await fetch('/api/emastoch?tf='+esTf)).json();
    const c=r.candidates||[];
    // TF uygunluk uyarısı (backtest): 1dk/5dk net negatif beklenti → uyar
    const tfCol=r.tf_grade==='kotu'?'#ff5470':r.tf_grade==='zayif'?'#f5c451':'#8aa0c8';
    const tfBanner=r.tf_note?`<div class="hint" style="margin:10px 0 4px;padding:8px 11px;border-radius:8px;background:${tfCol}1a;border:1px solid ${tfCol}44;color:${tfCol}">${r.tf_note}</div>`:'';
    const g=r.grades||{};
    $('#esGrid').innerHTML = tfBanner + (c.length? c.map(esCard).join('')
      : '<div class="muted" style="padding:30px">Şu an kurulumu tutan coin yok — hiçbiri (EMA50 üstü + %K&lt;30) ya da (EMA50 altı + %K&gt;70) koşulunu sağlamıyor. Zaman dilimini değiştir ya da birazdan tekrar dene.</div>');
    $('#esStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.count} aday</span>`+
        `<span class="stat-chip" style="color:var(--grn)">🟢 ${r.longs||0} al</span>`+
        `<span class="stat-chip" style="color:var(--red)">🔴 ${r.shorts||0} short</span>`+
        `<span class="stat-chip" title="A=trend uyumlu+kesişim (en iyi beklenti) · C=ters-trend uyarı">🏅 A${g.A||0} · B${g.B||0} · C${g.C||0}</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#esGrid .sq-card');
  }catch(e){ $('#esStatus').textContent='Hata: '+e; }
  esLoading=false;
}
document.querySelectorAll('.es-tf').forEach(b=>{
  b.addEventListener('click',()=>{
    esTf=b.dataset.tf;
    document.querySelectorAll('.es-tf').forEach(x=>x.classList.toggle('on',x===b));
    loadEmaStoch();
  });
});

/* ═══════════ Dip / Zirve (çoklu indikatör confluence) ═══════════ */
let dzLoading=false, dzTf='5';
function dzCard(r, log){
  const s=r.symbol.replace('USDT','');
  const isL=r.side==='LONG';
  const tag=isL?['sq-fresh','🟢 DİP · AL']:['sq-late','🔴 ZİRVE · SAT'];
  const cls=n=>n<0?'neg':'pos';
  const pf=n=>{ if(n==null) return '—'; n=+n; return n>=1?n.toLocaleString('en-US',{maximumFractionDigits:6})
                                 :n.toPrecision(4); };
  const mexc=r.symbol.replace(/USDT$/,'_USDT');
  const url=`https://futures.mexc.com/exchange/${mexc}`
    +`#ft_amt=5&ft_tp=${r.tp1}&ft_cls=80&ft_side=${isL?'long':'short'}`;
  const kcol=r.k<30?'#2fe08a':r.k>70?'#ff5470':'#a9b6d6';
  const gr=r.grade||'B';
  const gInfo={A:['#2fe08a','A · dönüş teyitli'],B:['#f5c451','B · teyit zayıf'],
               C:['#ff5470','C · teyitsiz ⚠']}[gr]||['#a9b6d6',gr];
  const gradeBadge=`<span class="sq-tag" style="background:${gInfo[0]}22;color:${gInfo[0]};font-weight:800" title="A=dönüş teyitli (kesişim+uç), C=teyitsiz (bıçak riski)">🏅 ${gInfo[1]}</span>`;
  const confBadge=`<span class="sq-tag" style="background:rgba(120,160,255,.14);color:#9db8ff;font-weight:800" title="Kaç basit indikatör aynı anda uçta">⚡ ${r.conds}/6</span>`;
  const crossBadge = r.cross!=='none'
    ? `<span class="sq-tag sq-fresh" style="background:rgba(47,224,138,.14);color:#2fe08a">✚ Dönüş kesişimi</span>` : '';
  const kar = r.kar!=null ? r.kar : r.tp2_pct;
  const reasons=(r.reasons||[]).map(x=>`<span class="sq-tag" style="background:rgba(255,255,255,.05);color:#9fb0d6;font-weight:600">${x}</span>`).join('');
  const tfLabel=(log&&r.tf?r.tf:dzTf)==='60'?'1sa':(log&&r.tf?r.tf:dzTf)+'dk';
  let logHead='';
  if(log){
    const d=new Date(r.ts*1000);
    const when=d.toLocaleDateString('tr-TR',{day:'2-digit',month:'2-digit'})+' '+d.toLocaleTimeString('tr-TR',{hour:'2-digit',minute:'2-digit'});
    const np=r.now_pct;
    const npHtml = np==null ? '<span class="v">—</span>'
      : `<span class="v ${np>=0?'pos':'neg'}" style="font-weight:800">${np>0?'+':''}${np}%</span>`;
    const outc = r.outcome ? {tp1:['#2fe08a','✅ Hedef 1'],tp2:['#2fe08a','✅ Hedef 2'],stop:['#ff5470','❌ Stop'],be:['#f5c451','↔ Başabaş'],zaman:['#a9b6d6','⏱ Zaman'],acik:['#a9b6d6','⏳ Açık']}[r.outcome] : null;
    logHead=`<div class="sq-rows" style="margin-bottom:6px;padding-bottom:6px;border-bottom:1px dashed rgba(255,255,255,.08)">
      <span class="k">Sinyal zamanı</span><span class="v" style="font-weight:800">${when}${r.src==='recon'?' <span class="sq-tag" style="background:rgba(245,196,81,.14);color:#f5c451;font-weight:700" title="Geriye dönük mum verisinden üretildi">⏪ geriye dönük</span>':''}</span>
      <span class="k">Şu an (yön lehine)</span>${npHtml}
      ${outc?`<span class="k">Sonuç (4s içinde)</span><span class="v" style="color:${outc[0]};font-weight:800">${outc[1]}${r.R!=null?' · '+(r.R>0?'+':'')+r.R+'R':''}</span>`:''}
    </div>`;
  }
  return `<div class="sq-card" onclick="openMexcTab('${url}')">
    ${logHead}
    <div class="sq-top"><span class="sq-sym">${s}</span><span class="sq-tr">${gradeBadge}${confBadge}${crossBadge}<button class="watchbtn" onclick="event.stopPropagation();watchSignal('${s}','${isL?'AL':'SAT'}','🎯 Dip / Zirve')">📈 Sinyal</button><span class="sq-tag ${tag[0]}">${tag[1]}</span></span></div>
    <div class="sq-rows">
      <span class="k">Fiyat</span><span class="v">${pf(r.price)}</span>
      <span class="k">RSI(14)</span><span class="v" style="color:${r.rsi<=30?'#2fe08a':r.rsi>=70?'#ff5470':'#a9b6d6'};font-weight:800">${r.rsi}</span>
      <span class="k">StochRSI %K</span><span class="v" style="color:${kcol};font-weight:800">${r.k}</span>
      <span class="k">StochRSI %D</span><span class="v">${r.d}</span>
      <span class="k">Bollinger konumu</span><span class="v" style="color:${r.bb_pos<=5?'#2fe08a':r.bb_pos>=95?'#ff5470':'#a9b6d6'};font-weight:800">%${r.bb_pos} ${r.bb_pos<=0?'(alt bant altı)':r.bb_pos>=100?'(üst bant üstü)':''}</span>
      <span class="k">EMA50 esnemesi</span><span class="v ${cls(r.dist_ema)}">${r.dist_ema>0?'+':''}${r.dist_ema}% · ${r.stretch}×ATR</span>
      <span class="k">24s hacim</span><span class="v">$${(r.vol24/1e6).toFixed(0)}M</span>
    </div>
    ${reasons?`<div class="row" style="gap:5px;flex-wrap:wrap;margin:8px 0 2px">${reasons}</div>`:''}
    <div class="tr-plan">
      <span class="k">Giriş</span><span class="v">${pf(r.entry)}</span>
      <span class="k">Stop</span><span class="v stp">${pf(r.stop)} · -${r.stop_pct}%</span>
      <span class="k">Hedef 1 (ortalama)</span><span class="v tgt">${pf(r.tp1)} · +${r.tp1_pct}%</span>
      <span class="k">Hedef 2</span><span class="v tgt">${pf(r.tp2)} · +${r.tp2_pct}%</span>
    </div>
    <div class="sq-foot">⚡ ${r.conds}/6 indikatör uçta · kalite ${r.q}/100 · ${tfLabel} grafik · dönüş (mean-reversion) confluence</div>
  </div>`;
}
async function loadDipZirve(){
  if(dzLoading) return; dzLoading=true;
  $('#dzStatus').innerHTML='<span class="spinner"></span> Bybit taranıyor... (dip / zirve confluence)';
  try{
    const r=await (await fetch('/api/dipzirve?tf='+dzTf)).json();
    const c=r.candidates||[];
    const g=r.grades||{};
    $('#dzGrid').innerHTML = c.length? c.map(dzCard).join('')
      : '<div class="muted" style="padding:30px">Şu an temel kapıyı tutan coin yok — hiçbiri (RSI≤34 + %K≤27 dip) ya da (RSI≥66 + %K≥73 zirve) koşulunu birlikte sağlamıyor. Zaman dilimini değiştir ya da birazdan tekrar dene.</div>';
    $('#dzStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.count} aday</span>`+
        `<span class="stat-chip" style="color:var(--grn)">🟢 ${r.longs||0} dip/al</span>`+
        `<span class="stat-chip" style="color:var(--red)">🔴 ${r.shorts||0} zirve/sat</span>`+
        `<span class="stat-chip" title="A=dönüş teyitli (en güçlü) · C=teyitsiz uyarı">🏅 A${g.A||0} · B${g.B||0} · C${g.C||0}</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#dzGrid .sq-card');
  }catch(e){ $('#dzStatus').textContent='Hata: '+e; }
  dzLoading=false;
}
document.querySelectorAll('.dz-tf').forEach(b=>{
  b.addEventListener('click',()=>{
    dzTf=b.dataset.tf;
    document.querySelectorAll('.dz-tf').forEach(x=>x.classList.toggle('on',x===b));
    loadDipZirve();
  });
});

/* ═══════════ DESTEK / DİRENÇ ═══════════ */
let srLoading=false, srMode='all', srData=null;
function srLvl(x,kind){
  if(!x) return '<span class="v">—</span>';
  const col = kind==='S' ? '#2fe08a' : '#ff5470';
  const hot = x.dist_atr<=0.5 ? ' style="font-weight:800;text-decoration:underline"' : '';
  return `<span class="v" title="${x.srcs.join(' · ')}"><span style="color:${col}"${hot}>${pf(x.p)}</span> · ${x.dist_pct>0?'+':''}${x.dist_pct}% · ${x.dist_atr}×ATR · ${x.n} temas${x.conf>1?' · ⚡'+x.conf:''}</span>`;
}
function srCard(r){
  const s=r.symbol.replace('USDT','');
  const url=`https://www.mexc.com/futures/${s}_USDT`;
  const sg=r.signal;
  let tag, tagStyle, typeBadge='';
  if(sg){
    const isL=sg.side==='LONG';
    tag=isL?'LONG · AL':'SHORT · SAT'; tagStyle=isL?'background:rgba(47,224,138,.16);color:#2fe08a':'background:rgba(255,84,112,.16);color:#ff5470';
    const tn={bounce:['DÖNÜŞ','#2fe08a'],breakout:['KIRILIM','#8b6bff'],retest:['RETEST','#f5c451']}[sg.type];
    typeBadge=`<span class="sq-tag" style="background:rgba(255,255,255,.06);color:${tn[1]};font-weight:800">${tn[0]}</span>`;
  } else if(r.near){
    tag = r.near.kind==='S' ? 'DESTEKTE · izle' : 'DİRENÇTE · izle';
    tagStyle = r.near.kind==='S' ? 'background:rgba(47,224,138,.08);color:#9fe0b8' : 'background:rgba(255,84,112,.08);color:#f0a0b0';
  } else { tag='seviyeler'; tagStyle='background:rgba(255,255,255,.05);color:#9fb0d6'; }
  const recent=(r.recent||[]).filter(x=>!(sg&&x.age===0)).map(x=>`<span class="sq-tag" style="background:rgba(255,255,255,.05);color:#9fb0d6;font-weight:600">${x.age*5}dk önce ${x.type} ${x.side} @${pf(x.level)}</span>`).join('');
  const plan = sg ? `<div class="tr-plan">
      <span class="k">Seviye (${sg.src})</span><span class="v">${pf(sg.level)} · ${sg.n} temas</span>
      <span class="k">Giriş</span><span class="v">${pf(sg.entry)}</span>
      <span class="k">Stop (seviye ∓1 ATR)</span><span class="v stp">${pf(sg.stop)} · -${sg.stop_pct}%</span>
      <span class="k">Hedef (${sg.rr}R)</span><span class="v tgt">${pf(sg.tp)} · +${sg.tp_pct}%</span>
      ${sg.next_level?`<span class="k">Yoldaki ilk seviye</span><span class="v" style="color:${sg.next_level_r<1?'#ff5470':'#a9b6d6'}">${pf(sg.next_level)} · ${sg.next_level_r}R ${sg.next_level_r<1?'⚠️ hedeften önce engel':''}</span>`:''}
    </div>` : '';
  return `<div class="sq-card" onclick="openMexcTab('${url}')">
    <div class="sq-top"><span class="sq-sym">${s}</span><span class="sq-tr">${typeBadge}${sg?`<button class="watchbtn" onclick="event.stopPropagation();watchSignal('${s}','${sg.side==='LONG'?'AL':'SAT'}','📐 Destek/Direnç')">📈 Sinyal</button>`:''}<span class="sq-tag" style="${tagStyle}">${tag}</span></span></div>
    <div class="sq-rows">
      <span class="k">Fiyat</span><span class="v">${pf(r.price)} · ATR %${r.atr_pct}</span>
      <span class="k">Direnç 2</span>${srLvl(r.resistances[1],'R')}
      <span class="k">Direnç 1</span>${srLvl(r.resistances[0],'R')}
      <span class="k">Destek 1</span>${srLvl(r.supports[0],'S')}
      <span class="k">Destek 2</span>${srLvl(r.supports[1],'S')}
      <span class="k">24s</span><span class="v ${cls(r.pc24)}">${r.pc24>0?'+':''}${r.pc24}% · $${(r.vol24/1e6).toFixed(0)}M · fund ${(r.funding*100).toFixed(3)}%</span>
    </div>
    ${plan}
    ${recent?`<div class="row" style="gap:5px;flex-wrap:wrap;margin:8px 0 2px">${recent}</div>`:''}
    <div class="sq-foot">📐 seviye = swing kümesi · alt çizili = ≤0.5 ATR mesafede · 5dk kapanış bazlı</div>
  </div>`;
}
function renderSR(){
  if(!srData) return;
  let c=srData.candidates||[];
  if(srMode==='sig') c=c.filter(r=>r.signal);
  if(srMode==='near') c=c.filter(r=>r.near||r.signal);
  $('#srGrid').innerHTML = c.length? c.map(srCard).join('') : '<div class="muted" style="padding:30px">Bu filtrede coin yok.</div>';
  enter('#srGrid .sq-card');
}
async function loadSR(){
  if(srLoading) return; srLoading=true;
  $('#srStatus').innerHTML='<span class="spinner"></span> Bybit taranıyor... (destek/direnç seviyeleri)';
  try{
    const r=await (await fetch('/api/sr?tf=5')).json(); srData=r; renderSR();
    $('#srStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.count} coin</span>`+
        `<span class="stat-chip" style="color:var(--grn)">🟢 ${r.longs||0} long sinyal</span>`+
        `<span class="stat-chip" style="color:var(--red)">🔴 ${r.shorts||0} short sinyal</span>`+
        `<span class="stat-chip">📍 ${r.near||0} seviyeye yakın</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
  }catch(e){ $('#srStatus').textContent='Hata: '+e; }
  srLoading=false;
}
document.querySelectorAll('.sr-mode').forEach(b=>{
  b.addEventListener('click',()=>{ srMode=b.dataset.mode; document.querySelectorAll('.sr-mode').forEach(x=>x.classList.toggle('on',x===b)); renderSR(); });
});

/* ═══════════ Dip / Zirve GEÇMİŞ (kaydedilen sinyaller) ═══════════ */
let dzlLoading=false, dzlTf='all', dzlH='24', dzlG='all';
async function loadDzLog(){
  if(dzlLoading) return; dzlLoading=true;
  $('#dzlStatus').innerHTML='<span class="spinner"></span> Kayıt defteri okunuyor...';
  try{
    const r=await (await fetch(`/api/dipzirve_log?tf=${dzlTf}&hours=${dzlH}`)).json();
    let c=r.signals||[];
    if(dzlG==='A') c=c.filter(x=>x.grade==='A');
    const g=r.grades||{};
    const wins=c.filter(x=>x.now_pct!=null&&x.now_pct>0).length;
    const withPx=c.filter(x=>x.now_pct!=null).length;
    $('#dzlGrid').innerHTML = c.length? c.map(x=>dzCard(x,true)).join('')
      : '<div class="muted" style="padding:30px">Bu pencerede kayıtlı sinyal yok. 5dk sinyalleri arka planda otomatik birikir; diğer dilimler Dip/Zirve sekmesi o dilimde açıkken kaydedilir.</div>';
    $('#dzlStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${c.length} sinyal</span>`+
        `<span class="stat-chip" style="color:var(--grn)">🟢 ${c.filter(x=>x.side==='LONG').length} dip/al</span>`+
        `<span class="stat-chip" style="color:var(--red)">🔴 ${c.filter(x=>x.side==='SHORT').length} zirve/sat</span>`+
        `<span class="stat-chip">🏅 A${c.filter(x=>x.grade==='A').length} · B${c.filter(x=>x.grade==='B').length} · C${c.filter(x=>x.grade==='C').length}</span>`+
        (withPx?`<span class="stat-chip" title="Sinyal girişinden şu ana kadar yön lehine olanlar">📈 şu an lehte ${wins}/${withPx} (%${Math.round(wins/withPx*100)})</span>`:'')+
        `<span class="stat-chip">toplam defter ${r.total_logged||0}</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#dzlGrid .sq-card');
  }catch(e){ $('#dzlStatus').textContent='Hata: '+e; }
  dzlLoading=false;
}
document.querySelectorAll('.dzl-tf').forEach(b=>b.addEventListener('click',()=>{
  dzlTf=b.dataset.tf; document.querySelectorAll('.dzl-tf').forEach(x=>x.classList.toggle('on',x===b)); loadDzLog(); }));
document.querySelectorAll('.dzl-h').forEach(b=>b.addEventListener('click',()=>{
  dzlH=b.dataset.h; document.querySelectorAll('.dzl-h').forEach(x=>x.classList.toggle('on',x===b)); loadDzLog(); }));
document.querySelectorAll('.dzl-g').forEach(b=>b.addEventListener('click',()=>{
  dzlG=b.dataset.g; document.querySelectorAll('.dzl-g').forEach(x=>x.classList.toggle('on',x===b)); loadDzLog(); }));

/* ═══════════ Bot İşlemleri (emastoch_bot.py paper bot canlı) ═══════════ */
let botLoading=false, botTf='5';

/* ═══════════ yeni bot işlemi bildirimi (sağ üst köşe + sesli) ═══════════ */
let botSeenMax = {};            // tf başına en son görülen işlem id'si
let botAudioCtx = null;
try{ botSeenMax = JSON.parse(localStorage.getItem('botSeenMax')||'{}'); }catch(e){}
// tarayıcı ses iznini ilk kullanıcı hareketinde aç
function botUnlockAudio(){
  try{
    if(!botAudioCtx) botAudioCtx = new (window.AudioContext||window.webkitAudioContext)();
    if(botAudioCtx.state==='suspended') botAudioCtx.resume();
  }catch(e){}
}
window.addEventListener('pointerdown', botUnlockAudio, {once:false});
// yüksek sesli çift-tonlu uyarı
function botBeep(){
  try{
    botUnlockAudio();
    const ctx = botAudioCtx; if(!ctx) return;
    const now = ctx.currentTime;
    const master = ctx.createGain();
    master.gain.value = 0.9;            // yüksek ses
    master.connect(ctx.destination);
    // 3 hızlı "ping" — dikkat çekici
    [ [880,0.00], [1320,0.16], [1760,0.32] ].forEach(([f,dt])=>{
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.type='triangle'; o.frequency.value=f;
      o.connect(g); g.connect(master);
      const t0 = now+dt;
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(1.0, t0+0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t0+0.15);
      o.start(t0); o.stop(t0+0.16);
    });
  }catch(e){}
}
function botToastInit(){
  if(document.getElementById('botToastWrap')) return;
  const st = document.createElement('style');
  st.textContent = `
    #botToastWrap{position:fixed;top:16px;right:16px;z-index:9999;display:flex;flex-direction:column;gap:10px;max-width:340px}
    .bot-toast{background:#141a2b;border:1px solid #2a3350;border-left:4px solid #2fe08a;
      border-radius:12px;padding:12px 14px;box-shadow:0 12px 34px -10px rgba(0,0,0,.6);
      color:#e7ecf6;font-size:13px;cursor:pointer;animation:botToastIn .35s cubic-bezier(.2,.9,.3,1.3)}
    .bot-toast.short{border-left-color:#ff5470}
    .bot-toast .tt{font-weight:800;font-size:14px;margin-bottom:3px}
    .bot-toast .sub{opacity:.8}
    @keyframes botToastIn{from{transform:translateX(120%);opacity:0}to{transform:translateX(0);opacity:1}}
    @keyframes botToastOut{to{transform:translateX(120%);opacity:0}}`;
  document.head.appendChild(st);
  const w = document.createElement('div'); w.id='botToastWrap';
  document.body.appendChild(w);
}
function botToast(t){
  botToastInit();
  const long = t.side==='LONG';
  const el = document.createElement('div');
  el.className = 'bot-toast'+(long?'':' short');
  el.innerHTML = `<div class="tt">🔔 Yeni sinyal · ${long?'🟢 LONG':'🔴 SHORT'}</div>
    <div class="sub"><b>${t.symbol}</b> · giriş ${t.entry!=null?t.entry:'—'} · #${t.id}${t.opened?' · '+t.opened:''}</div>`;
  const mexc=(t.symbol||'').replace(/USDT$/,'_USDT');
  el.onclick = ()=>{ try{ openMexcTab('https://futures.mexc.com/exchange/'+mexc); }catch(e){} el.remove(); };
  document.getElementById('botToastWrap').prepend(el);
  botBeep();
  setTimeout(()=>{ el.style.animation='botToastOut .3s forwards'; setTimeout(()=>el.remove(),320); }, 12000);
}
// yeni işlemleri tespit et; ilk yüklemede sadece taban belirle (spam yok)
function botCheckNew(trs){
  if(!trs || !trs.length) return;
  const ids = trs.map(t=>+t.id).filter(n=>!isNaN(n));
  if(!ids.length) return;
  const maxId = Math.max(...ids);
  const prev = botSeenMax[botTf];
  if(prev==null){                     // bu tf ilk kez yükleniyor → sessiz taban
    botSeenMax[botTf]=maxId;
    try{ localStorage.setItem('botSeenMax',JSON.stringify(botSeenMax)); }catch(e){}
    return;
  }
  if(maxId>prev){
    trs.filter(t=>+t.id>prev)
       .sort((a,b)=>(+a.id)-(+b.id))
       .forEach(botToast);
    botSeenMax[botTf]=maxId;
    try{ localStorage.setItem('botSeenMax',JSON.stringify(botSeenMax)); }catch(e){}
  }
}
function botFld(lbl,val,col){
  return `<div style="display:flex;flex-direction:column;gap:1px">
    <span style="font-size:10px;letter-spacing:.3px;opacity:.55;text-transform:uppercase">${lbl}</span>
    <span style="font-weight:700${col?';color:'+col:''}">${val}</span></div>`;
}
function botCard(t){
  const closed=t.closed;
  const long = t.side==='LONG';
  const sideCol = long?'#2fe08a':'#ff5470';
  const sideTxt = long?'🟢 LONG':'🔴 SHORT';
  const rmap={tp2:'🎯 TP2 tamam',stop:'🛑 stop',zaman:'⏰ zaman doldu'};
  const st = closed
    ? `<span class="stat-chip" style="opacity:.8">${rmap[t.result]||t.result||'KAPALI'}</span>`
    : `<span class="stat-chip" style="background:#f5c45122;color:#f5c451">● İZLENİYOR</span>`;
  const endR = t.end_r!=null ? +t.end_r : null;
  const maxR = t.max_r!=null ? +t.max_r : 0;
  const rCol = v => v>0?'#2fe08a':(v<0?'#ff5470':'#8aa0c8');
  const rTxt = closed && endR!=null
    ? `<b style="color:${rCol(endR)};font-size:15px">${endR>=0?'+':''}${endR.toFixed(2)}R</b>`
    : `<b style="color:${rCol(maxR)};font-size:15px">max +${maxR.toFixed(2)}R</b>`;
  const ago = t.opened_ts ? (Date.now()/1000 - t.opened_ts)/60 : null;
  const dur = closed
    ? (t.hold_min!=null ? `${t.hold_min}dk izlendi` : '')
    : (ago!=null ? `${ago<1?'<1':Math.round(ago)} dk önce` : '');
  const crossTxt = t.cross==='bull' ? '✚ boğa kesişim'
                 : t.cross==='bear' ? '✚ ayı kesişim' : 'kesişim yok';
  const lvl = (lbl,val,hit,col)=>`<div style="display:flex;flex-direction:column;gap:1px;padding:6px 8px;border-radius:8px;background:${hit?col+'22':'#8aa0c810'};border:1px solid ${hit?col:'#8aa0c81a'}">
    <span style="font-size:10px;letter-spacing:.3px;opacity:.6;text-transform:uppercase">${lbl}</span>
    <span style="font-weight:800;color:${col}">${val}${hit?' ✓':''}</span></div>`;
  const warns=(t.warn||[]);
  const warnHtml = warns.length
    ? `<div class="hint" style="margin-top:8px;color:#f5c451">⚠️ ${warns.join(' · ')}</div>` : '';
  const mexc=t.symbol.replace(/USDT$/,'_USDT');
  const url=`https://futures.mexc.com/exchange/${mexc}`;
  return `<div class="sq-card" onclick="openMexcTab('${url}')" title="MEXC grafiğini aç: ${t.symbol}" style="border-left:3px solid ${sideCol};cursor:pointer">
    <div class="row" style="justify-content:space-between;align-items:center">
      <div><b style="color:${sideCol}">${sideTxt}</b> <b style="font-size:15px">${t.symbol}</b> <span class="stat-chip">#${t.id}</span></div>
      <div>${st} ${rTxt}</div>
    </div>
    <div style="margin-top:9px;padding:7px 10px;border-radius:8px;background:#8aa0c810;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <span style="font-size:13px">🕐 <b>Sinyal ${t.opened}</b></span>
      ${dur?`<span class="stat-chip" style="opacity:.85">${dur}</span>`:''}
    </div>
    <div style="margin-top:9px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px">
      ${lvl('Giriş', t.entry, false, '#e7ecf6')}
      ${lvl('Stop %'+t.stop_pct, t.stop, t.stop_hit, '#ff5470')}
      ${lvl('TP1 +1.5R', t.tp1, t.tp1_hit, '#2fe08a')}
      ${lvl('TP2 +2.5R', t.tp2, t.tp2_hit, '#2fe08a')}
    </div>
    <div style="margin-top:9px;display:grid;grid-template-columns:repeat(4,1fr);gap:9px 12px">
      ${botFld('EMA uzaklık', t.dist_ema+'%', Math.abs(t.dist_ema)>2?'#f5c451':'')}
      ${botFld('Skor', t.score)}
      ${botFld('Teyit', crossTxt, t.cross!=='none'?'#2fe08a':'#8aa0c8')}
      ${botFld('StochRSI %K/%D', t.k+' / '+t.d)}
      ${botFld('RSI', t.rsi)}
      ${botFld('ADX (trend gücü)', t.adx)}
      ${botFld('ATR', '%'+t.atr_pct)}
      ${botFld('24s', t.pc24!=null?((t.pc24*100).toFixed(1)+'%'):'—')}
    </div>
    ${warnHtml}
  </div>`;
}
async function loadBotTrades(){
  if(botLoading) return; botLoading=true;
  $('#botStatus').innerHTML='<span class="spinner"></span> Sinyaller yükleniyor...';
  try{
    const r=await (await fetch('/api/bottrades?tf='+botTf)).json();
    if(!r.exists){
      $('#botSummary').innerHTML = `<span class="stat-chip" style="color:${r.running?'#2fe08a':'#ff5470'}">${r.running?'● Bot çalışıyor':'○ Bot kapalı'}</span>`;
      $('#botStatus').innerHTML='';
      $('#botGrid').innerHTML = `<div class="muted" style="padding:30px">Bu zaman diliminde (${botTf}dk) henüz sinyal yok.
        Botu başlat: <code>.venv/bin/python emastoch_bot.py ${botTf}</code></div>`;
      botLoading=false; return;
    }
    const trs=r.trades||[];
    const rc = v => v>0?'#2fe08a':(v<0?'#ff5470':'#8aa0c8');
    $('#botSummary').innerHTML =
      `<span class="stat-chip" style="color:${r.running?'#2fe08a':'#ff5470'}">${r.running?'● Bot çalışıyor':'○ Bot kapalı'}</span>`+
      `<span class="stat-chip hi">📡 ${r.count} sinyal</span>`+
      `<span class="stat-chip" style="color:#f5c451">● ${r.open} izleniyor</span>`+
      `<span class="stat-chip">🎯 TP1 %${r.tp1_pct} · TP2 %${r.tp2_pct} · 🛑 stop %${r.stop_pct} (${r.closed} kapanan)</span>`+
      (r.closed?`<span class="stat-chip" style="color:${rc(r.avg_end_r)}">ort. son ${r.avg_end_r>=0?'+':''}${r.avg_end_r}R · ort. max +${r.avg_max_r}R</span>`:'');
    $('#botStatus').innerHTML = `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    const shown = trs.slice(0,30);   // en yeni üstte → son 30 sinyal
    const moreNote = trs.length>shown.length
      ? `<div class="muted" style="padding:10px 4px 4px;text-align:center">Son ${shown.length} sinyal gösteriliyor · toplam ${trs.length}</div>`
      : '';
    $('#botGrid').innerHTML = shown.length ? shown.map(botCard).join('')+moreNote
      : '<div class="muted" style="padding:30px">Henüz sinyal yok — bot uygun kurulum bekliyor.</div>';
    enter('#botGrid .sq-card');
    botCheckNew(trs);   // yeni sinyal geldiyse sağ üstte sesli bildirim
  }catch(e){ $('#botStatus').textContent='Hata: '+e; }
  botLoading=false;
}
document.querySelectorAll('.bot-tf').forEach(b=>{
  b.addEventListener('click',()=>{
    botTf=b.dataset.tf;
    document.querySelectorAll('.bot-tf').forEach(x=>x.classList.toggle('on',x===b));
    loadBotTrades();
  });
});

/* ═══════════ pro trend (MTF · 5dk trend + 1dk giris · 4-5 mum devam) ═══════════ */
let ptLoading=false;
function ptCard(r){
  const s=r.symbol.replace('USDT','');
  const isL=r.side==='LONG';
  const tag=isL?['sq-fresh','🟢 LONG']:['sq-late','🔴 SHORT'];
  const sign=n=>(n>0?'+':'')+(n*100).toFixed(2)+'%';
  const cls=n=>n<0?'neg':'pos';
  const pf=n=>{ n=+n; return n>=1?n.toLocaleString('en-US',{maximumFractionDigits:4})
                                 :n.toPrecision(4); };
  const mexc=r.symbol.replace(/USDT$/,'_USDT');
  const url=`https://futures.mexc.com/exchange/${mexc}`
    +`#ft_amt=5&ft_tp=${r.tp1}&ft_cls=80&ft_side=${isL?'long':'short'}`;
  const cf=r.conf>=72?'#2fe08a':r.conf>=64?'#ffc148':'#a9b6d6';
  return `<div class="sq-card" onclick="openMexc('${url}')">
    <div class="sq-top"><span class="sq-sym">${s}</span><span class="sq-tr"><button class="watchbtn" onclick="event.stopPropagation();watchSignal('${s}','${isL?'AL':'SAT'}','🎯 Pro Trend')">📈 Sinyal</button><span class="sq-tag ${tag[0]}">${tag[1]}</span></span></div>
    <div class="pt-conf">
      <span class="pt-cbar"><span class="pt-cfill" style="width:${Math.min(r.conf,100)}%;background:${cf}"></span></span>
      <span class="pt-clab" style="color:${cf}">Güven %${r.conf} · ~${r.exp_candles} mum devam</span>
    </div>
    <div class="sq-rows">
      <span class="k">ADX 1dk</span><span class="v">${r.adx1}</span>
      <span class="k">ADX 5dk</span><span class="v">${r.adx5}</span>
      <span class="k">Son 5dk</span><span class="v ${cls(r.m5)}">${sign(r.m5)}</span>
      <span class="k">Son 15dk</span><span class="v ${cls(r.m15)}">${sign(r.m15)}</span>
      <span class="k">Hacim</span><span class="v">${r.vspike.toFixed(1)}x</span>
      <span class="k">Oynaklık (ATR)</span><span class="v">${r.atr_pct.toFixed(2)}%</span>
    </div>
    <div class="tr-plan">
      <span class="k">Giriş (1dk)</span><span class="v">${pf(r.entry)}</span>
      <span class="k">Stop</span><span class="v stp">${pf(r.stop)} · -${r.stop_pct}%</span>
      <span class="k">Hedef 1</span><span class="v tgt">${pf(r.tp1)} · +${r.tp1_pct}%</span>
      <span class="k">Hedef 2 (${r.exp_candles}. mum)</span><span class="v tgt">${pf(r.tp2)} · +${r.tp2_pct}%</span>
    </div>
    <div class="sq-foot">güven %${r.conf} · R:R ${r.rr} · 5dk+1dk teyitli · 1dk grafikte gir</div>
  </div>`;
}
async function loadProTrend(){
  if(ptLoading) return; ptLoading=true;
  $('#ptStatus').innerHTML='<span class="spinner"></span> Bybit taranıyor... (5dk trend + 1dk giriş, MTF)';
  try{
    const r=await (await fetch('/api/protrend')).json();
    const c=r.candidates||[];
    $('#ptGrid').innerHTML = c.length? c.map(ptCard).join('')
      : '<div class="muted" style="padding:30px">Şu an iki zaman diliminde de teyitli, taze bir kurulum yok — piyasa yönsüz/sıkışık. 4-5 mum devam garantisi olan aday çıkmadı, birazdan tekrar dene.</div>';
    $('#ptStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.count} pro aday</span>`+
        `<span class="stat-chip" style="color:var(--grn)">🟢 ${r.longs||0} long</span>`+
        `<span class="stat-chip" style="color:var(--red)">🔴 ${r.shorts||0} short</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#ptGrid .sq-card');
  }catch(e){ $('#ptStatus').textContent='Hata: '+e; }
  ptLoading=false;
}

/* ═══════════ 1dk scalp (en secici · pullback/breakout + onay) ═══════════ */
let scLoading=false;
function scCard(r){
  const s=r.symbol.replace('USDT','');
  const isL=r.side==='LONG';
  const tag=isL?['sq-fresh','🟢 LONG']:['sq-late','🔴 SHORT'];
  const setupBadge=r.setup==='PULLBACK'?'↩︎ PULLBACK':'⚡ BREAKOUT';
  const sign=n=>(n>0?'+':'')+(n*100).toFixed(2)+'%';
  const cls=n=>n<0?'neg':'pos';
  const pf=n=>{ n=+n; return n>=1?n.toLocaleString('en-US',{maximumFractionDigits:4})
                                 :n.toPrecision(4); };
  const mexc=r.symbol.replace(/USDT$/,'_USDT');
  const url=`https://futures.mexc.com/exchange/${mexc}`
    +`#ft_amt=5&ft_tp=${r.tp1}&ft_cls=80&ft_side=${isL?'long':'short'}`;
  const cf=r.conf>=78?'#2fe08a':r.conf>=70?'#ffc148':'#a9b6d6';
  return `<div class="sq-card" onclick="openMexc('${url}')">
    <div class="sq-top"><span class="sq-sym">${s}</span>
      <span style="display:flex;gap:6px;align-items:center">
        <button class="watchbtn" onclick="event.stopPropagation();watchSignal('${s}','${isL?'AL':'SAT'}','🔥 1dk Scalp')">📈 Sinyal</button>
        <span class="sq-tag" style="background:rgba(120,140,200,.14);color:#aeb9dd">${setupBadge}</span>
        <span class="sq-tag ${tag[0]}">${tag[1]}</span></span></div>
    <div class="pt-conf">
      <span class="pt-cbar"><span class="pt-cfill" style="width:${Math.min(r.conf,100)}%;background:${cf}"></span></span>
      <span class="pt-clab" style="color:${cf}">Güven %${r.conf} · ~${r.exp_candles} mum devam · R:R ${r.rr}</span>
    </div>
    <div class="sq-rows">
      <span class="k">Kurulum</span><span class="v">${r.setup==='PULLBACK'?'Geri çekilme':'Kırılım'}</span>
      <span class="k">ADX 1dk / 5dk</span><span class="v">${r.adx1} / ${r.adx5}</span>
      <span class="k">EMA9 uzaklık</span><span class="v">${r.dist9}%</span>
      <span class="k">Son 5dk</span><span class="v ${cls(r.m5)}">${sign(r.m5)}</span>
      <span class="k">Hacim</span><span class="v">${r.vspike.toFixed(1)}x</span>
      <span class="k">Oynaklık (ATR)</span><span class="v">${r.atr_pct.toFixed(2)}%</span>
    </div>
    <div class="tr-plan">
      <span class="k">Giriş (1dk)</span><span class="v">${pf(r.entry)}</span>
      <span class="k">Stop (yapı)</span><span class="v stp">${pf(r.stop)} · -${r.stop_pct}%</span>
      <span class="k">Hedef 1</span><span class="v tgt">${pf(r.tp1)} · +${r.tp1_pct}%</span>
      <span class="k">Hedef 2 (${r.exp_candles}. mum)</span><span class="v tgt">${pf(r.tp2)} · +${r.tp2_pct}%</span>
    </div>
    <div class="sq-foot">${r.setup==='PULLBACK'?'EMA9 pullback':'taze kırılım'} · güven %${r.conf} · 1dk grafikte gir, stop şart</div>
  </div>`;
}
async function loadScalp(){
  if(scLoading) return; scLoading=true;
  $('#scStatus').innerHTML='<span class="spinner"></span> Bybit taranıyor... (5dk trend + 1dk scalp giriş kalitesi)';
  try{
    const r=await (await fetch('/api/scalp')).json();
    const c=r.candidates||[];
    $('#scGrid').innerHTML = c.length? c.map(scCard).join('')
      : '<div class="muted" style="padding:30px">Şu an kaliteli bir 1dk scalp kurulumu yok — ne taze pullback ne temiz kırılım oluştu. Sistem kalitesiz/uzamış girişte coin uydurmaz. Birazdan tekrar dene.</div>';
    $('#scStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.count} scalp kurulumu</span>`+
        `<span class="stat-chip" style="color:var(--grn)">🟢 ${r.longs||0} long</span>`+
        `<span class="stat-chip" style="color:var(--red)">🔴 ${r.shorts||0} short</span>`+
        `<span class="stat-chip">${new Date(r.ts*1000).toLocaleTimeString('tr-TR')}</span>`;
    enter('#scGrid .sq-card');
  }catch(e){ $('#scStatus').textContent='Hata: '+e; }
  scLoading=false;
}

/* ═══════════ tarama ═══════════ */
async function doScan(){
  $('#scanBtn').disabled = true;
  $('#scanBtn').textContent = 'Taranıyor…';
  await fetch('/api/scan', {method:'POST'});
}

function fmt(n, d=6){
  if(n===null||n===undefined) return '—';
  return (+n).toLocaleString('en-US',{maximumSignificantDigits:d});
}
function pct(n){ return n===null||n===undefined?'—':(n*100).toFixed(2)+'%'; }
function pctCls(n){ return n>0?'pos':(n<0?'neg':''); }
function crossBadge(c){
  const bf = c.binance_funding;
  const bft = bf===null||bf===undefined ? '' :
    ` <span class="muted" style="font-family:'JetBrains Mono';font-size:11px">Binance ${(bf*100).toFixed(3)}%</span>`;
  switch(c.cross){
    case 'confirmed': return `<span class="pill long">✓ Binance onaylı</span>${bft}`;
    case 'diverge':   return `<span class="pill short">⚠ Binance ters</span>${bft}`;
    case 'mexc_only': return `<span class="pill" style="background:rgba(255,193,72,.14);color:var(--amb);box-shadow:inset 0 0 0 1px rgba(255,193,72,.3)">⚠ sadece MEXC</span>`;
    case 'weak':      return `<span class="pill wait">Binance zayıf</span>${bft}`;
    default: return '';
  }
}

let lastScanSig='';
function renderCands(sc){
  const box = $('#cands');
  if(sc.status==='running'){
    $('#scanStatus').innerHTML = '<span class="spinner"></span> Taranıyor... 1000+ parite işleniyor (1-2 dk sürebilir)';
    $('#scanBtn').disabled = true;
    $('#scanBtn').textContent = 'Taranıyor…';
    lastScanSig='running';
    return;
  }
  $('#scanBtn').disabled = false;
  $('#scanBtn').textContent = 'Tara ve Planla';
  if(sc.status==='idle'){ $('#scanStatus').textContent=''; return; }
  if(sc.status==='error'){ $('#scanStatus').textContent='Hata: '+sc.msg; return; }

  const cands = sc.candidates||[];
  const trade = cands.filter(c=>c.tradeable);
  const wait  = cands.filter(c=>!c.tradeable);
  const wl = sc.watchlist||[];

  // diff — aynı veri her 2sn yeniden çizilip flicker/animasyon tekrarı yapmasın
  const sig = JSON.stringify({t:sc.ts,s:sc.status,
    tr:trade.map(c=>[c.symbol,c.side,c.z]),
    wa:wait.map(c=>c.symbol),
    wl:wl.map(w=>[w.symbol,w.proximity])});
  if(sig===lastScanSig) return;
  lastScanSig=sig;

  $('#scanStatus').innerHTML =
    `<span class="stat-chip">${cands.length} aday</span>`+
    `<span class="stat-chip hi">${trade.length} işlenebilir</span>`+
    `<span class="stat-chip">${new Date(sc.ts*1000).toLocaleTimeString('tr-TR')}</span>`;

  let html='';
  if(cands.length===0){
    html += '<div class="cand"><b>İşlem sinyali yok.</b> <span class="muted">Şu an eşiği geçen '+
      'sıkışmış kalabalık yok — bu normal, funding uç değil. '+
      'Aşağıda en yakın coinler var; biri "yakınlık 1.0"a ulaşınca sinyal olur.</span></div>';
  }
  for(const c of trade){
    const p=c.plan, side=c.side.toLowerCase();
    html += `<div class="cand trade side-${side}">
      <div class="row" style="justify-content:space-between">
        <div><h3>${c.symbol} <span class="pill ${side}">${c.side}</span>
          <span class="setup-tag">${c.setup}</span></h3>
          <div style="margin-top:7px">${crossBadge(c)}</div></div>
        <button class="btn grn" onclick="startWatch('${c.symbol}')">Canlı Takip Et →</button>
      </div>
      <div class="grid">
        <div class="kv"><small>funding z</small><b>${c.z}</b></div>
        <div class="kv"><small>funding 8s</small><b class="${pctCls(c.funding_norm)}">${pct(c.funding_norm)}</b></div>
        <div class="kv"><small>8s getiri</small><b class="${pctCls(c.ret_8h)}">${pct(c.ret_8h)}</b></div>
        <div class="kv"><small>ATR</small><b>${pct(c.atr_pct)}</b></div>
        <div class="kv"><small>OI</small><b>$${(c.oi_usd/1e6).toFixed(1)}M</b></div>
      </div>
      <div class="plan"><div class="plan-label">İşlem Planı</div><div class="grid">
        <div class="kv"><small>Giriş (limit)</small><b>${fmt(p.entry)}</b></div>
        <div class="kv"><small>Stop</small><b class="neg">${fmt(p.stop)} <span class="muted" style="font-size:11px">${pct(p.stop_pct)}</span></b></div>
        <div class="kv"><small>Hedef 1</small><b class="pos">${fmt(p.tp1)}</b></div>
        <div class="kv"><small>Hedef 2</small><b class="pos">${fmt(p.tp2)}</b></div>
        <div class="kv"><small>Boyut</small><b>$${p.notional_usd.toFixed(1)}</b></div>
        <div class="kv"><small>Kaldıraç</small><b>${p.suggested_leverage}x</b></div>
        <div class="kv"><small>Risk</small><b>$${p.risk_usd.toFixed(2)}</b></div>
      </div>
      <div class="hint" style="margin-top:10px">Rakamlar provizyonel (son 5dk). "Canlı Takip Et" gerçek
        referans mumla kesinleştirir.</div></div>
    </div>`;
  }
  if(wait.length){
    html += '<div class="hint" style="margin-top:18px;font-weight:600;color:var(--dim)">İzlemede (yön henüz çelişmiyor)</div>';
    for(const c of wait){
      html += `<div class="cand"><div class="row" style="justify-content:space-between">
        <div>${c.symbol} <span class="pill wait">${c.crowd} kalabalık</span>
          <span class="muted mono" style="font-size:12px">z=${c.z} · funding ${pct(c.funding_norm)}</span></div>
        <button class="btn ghost" onclick="startWatch('${c.symbol}')">Yine de izle</button>
      </div></div>`;
    }
  }
  if(wl.length){
    html += '<div class="hint" style="margin-top:20px;border-top:1px solid var(--line);padding-top:16px;font-weight:600;color:var(--txt)">'+
      '📡 İzleme listesi <span class="muted" style="font-weight:400">— eşiği geçmedi, funding oluşuyor mu diye izle (yakınlık 1.0 = sinyal)</span></div>';
    for(const w of wl){
      const bar = Math.min(100, Math.round(w.proximity*100));
      const hot = bar>=100;
      html += `<div class="cand" style="padding:13px 16px">
        <div class="row" style="justify-content:space-between">
          <div>${w.symbol}
            <span class="pill ${w.crowd.toLowerCase()}">${w.crowd} kalabalık</span>
            <span class="muted mono" style="font-size:12px">z=${w.z} · funding ${pct(w.funding_norm)}</span></div>
          <div class="muted mono" style="font-size:12px">yakınlık ${w.proximity}</div>
        </div>
        <div style="margin-top:8px">${crossBadge(w)}</div>
        <div class="prox-track">
          <div class="prox-fill ${hot?'hot':'warm'}" style="width:${bar}%"></div>
        </div>
        <div class="hint" style="margin-top:7px">eksik: ${(w.fails||[]).join(', ')||'—'}</div>
      </div>`;
    }
  }
  box.innerHTML = html;
  enter('#cands > .cand', box);
}

/* ═══════════ canlı takip ═══════════ */
async function startWatch(sym){
  await fetch('/api/watch',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({symbol:sym})});
}
async function confirmEntry(){ await fetch('/api/watch/confirm',{method:'POST'}); }
async function stopWatch(){ await fetch('/api/watch/stop',{method:'POST'}); }

const PHASES = [
  ['reference','Referans mum'],['waiting','Tetik bekle'],
  ['entry','Giriş'],['monitor','Çıkış izle'],['done','Bitti']
];
let lastWatchPhase='';
function renderWatch(w){
  const card=$('#watchCard');
  if(!w){ card.style.display='none'; lastWatchPhase=''; return; }
  const wasHidden = card.style.display==='none';
  card.style.display='block';
  if(wasHidden && HAS_GSAP && !RM)
    gsap.fromTo(card,{opacity:0,y:20},{opacity:1,y:0,duration:.7,ease:'power3.out'});

  const order=['init','reference','waiting','entry','monitor','done'];
  const cur=order.indexOf(w.phase);
  $('#steps').innerHTML = PHASES.map(([k,lbl])=>{
    let cls='step';
    const ki=order.indexOf(k);
    if(w.phase===k) cls+=' on';
    else if(ki>=0 && ki<cur) cls+=' ok';
    if(w.phase==='done'&&k==='done') cls='step ok';
    return `<div class="${cls}"><span class="si"></span>${lbl}</div>`;
  }).join('');

  let body=`<div class="row" style="justify-content:space-between">
    <div><h3 style="margin:0;font:600 18px/1.2 'Space Grotesk';display:flex;gap:9px;align-items:center;flex-wrap:wrap">${w.symbol}
      ${w.side?`<span class="pill ${w.side.toLowerCase()}">${w.side}</span>`:''}</h3>
      <div class="hint" style="margin-top:5px">${w.message||''}</div></div>
    <button class="btn red" onclick="stopWatch()">Durdur</button></div>`;

  if(w.signal==='ENTRY'){
    body += `<div class="signal entry">🟢 GİRİŞ SİNYALİ — ${w.side} ${w.symbol}
      <small>MEXC'te aç: giriş ${fmt(w.plan.entry)}, stop ${fmt(w.plan.stop)}, ${w.plan.suggested_leverage}x</small></div>
      <button class="btn grn" onclick="confirmEntry()">Pozisyonu Açtım →</button>`;
  }
  if(w.signal==='EXIT_TP')
    body += `<div class="signal exit">🟡 KÂR AL <small>OI yakıtı bitiyor.</small></div>`;
  if(w.signal==='EXIT_TIME')
    body += `<div class="signal exit">⏹ ZAMAN STOPU <small>koşulsuz kapat.</small></div>`;

  if(w.plan){
    const p=w.plan;
    body += `<div class="grid" style="margin-top:14px">
      <div class="kv"><small>Fiyat</small><b class="big">${fmt(w.price)}</b></div>
      <div class="kv"><small>Giriş/Tetik</small><b>${fmt(p.entry)}</b></div>
      <div class="kv"><small>Stop</small><b class="neg">${fmt(p.stop)}</b></div>
      <div class="kv"><small>Hedef 1 / 2</small><b class="pos">${fmt(p.tp1)} / ${fmt(p.tp2)}</b></div>
      <div class="kv"><small>Boyut / Kaldıraç</small><b>$${p.notional_usd.toFixed(1)} · ${p.suggested_leverage}x</b></div>
      ${w.oi_usd?`<div class="kv"><small>OI (düşüş)</small><b>$${(w.oi_usd/1e6).toFixed(1)}M <span class="muted" style="font-size:11px">${w.oi_drop_pct}%</span></b></div>`:''}
      ${w.elapsed_min!=null?`<div class="kv"><small>Geçen süre</small><b>${w.elapsed_min} dk</b></div>`:''}
    </div>`;
  } else if(w.ref_high){
    body += `<div class="grid" style="margin-top:14px">
      <div class="kv"><small>Fiyat</small><b class="big">${fmt(w.price)}</b></div>
      <div class="kv"><small>Ref H</small><b class="pos">${fmt(w.ref_high)}</b></div>
      <div class="kv"><small>Ref L</small><b class="neg">${fmt(w.ref_low)}</b></div></div>`;
  }
  body += `<div class="log">${(w.log||[]).join('\n')}</div>`;
  $('#watchBody').innerHTML = body;

  // faz değişiminde vurgu animasyonu
  const psig = w.phase+'|'+(w.signal||'');
  if(psig!==lastWatchPhase){
    lastWatchPhase=psig;
    if(HAS_GSAP && !RM){
      gsap.fromTo('#steps .step',{opacity:.4,y:8},
        {opacity:1,y:0,duration:.55,ease:'power3.out',stagger:.06,overwrite:true});
      const sigEl=document.querySelector('#watchBody .signal');
      if(sigEl) gsap.fromTo(sigEl,{scale:.9,opacity:0},
        {scale:1,opacity:1,duration:.6,ease:'back.out(1.7)'});
    }
  }
}

/* ═══════════ plan · direnç/kırılım ═══════════ */
let planLoading=false, curPlanId=null;
function fnum(x){
  if(x==null) return '—';
  const a=Math.abs(x);
  const d = a>=100?2 : a>=1?4 : a>=0.01?5 : 7;
  return (+x).toFixed(d).replace(/\.?0+$/,'');
}
function planRow(c,i){
  return `<tr>
    <td class="muted">${i+1}</td>
    <td><span class="sym">${c.symbol.replace('USDT','')}</span></td>
    <td><span class="side">🟢 ${c.side}</span></td>
    <td><span class="lv">${fnum(c.entry)}</span></td>
    <td><span class="lv stp">${fnum(c.stop)}</span> <span class="pct">−${c.stop_pct}%</span></td>
    <td><span class="lv tgt">${fnum(c.tp1)}</span> <span class="pct">+${c.tp1_pct}%</span></td>
    <td><span class="lv tgt">${fnum(c.tp2)}</span> <span class="pct">+${c.tp2_pct}%</span></td>
    <td class="res">R1 ${fnum(c.res1)}<br>R2 ${fnum(c.res2)}<br><span class="muted">Dest ${fnum(c.support)}</span></td>
    <td><button class="mini armbtn" id="arm-${c.symbol}" onclick="armPlan('${c.symbol}')">🔔 İzle</button></td>
  </tr>`;
}
let planCands={};
function renderPlan(d){
  const cs=d.candidates||[];
  planCands={}; cs.forEach(c=>{planCands[c.symbol]=c;});
  $('#planRows').innerHTML = cs.length
    ? cs.map(planRow).join('')
    : '<tr><td colspan="9" class="muted">Şu an kritere uyan kırılım adayı yok. Sonra tekrar dene.</td></tr>';
  const when = d.ts_tr || (d.ts? new Date(d.ts*1000).toLocaleString('tr-TR'):'');
  $('#planStatus').innerHTML =
    `<span class="stat-chip hi">${cs.length} aday</span>`+
    (when?`<span class="stat-chip">${when}</span>`:'');
  enter('#planRows tr');
}
async function runPlan(){
  if(planLoading) return; planLoading=true;
  const btn=$('#planScanBtn'); btn.disabled=true; const old=btn.textContent;
  btn.textContent='⏳ Taranıyor…';
  $('#planStatus').innerHTML='<span class="stat-chip">piyasa taranıyor, ~10 sn…</span>';
  try{
    const r=await fetch('/api/plan/scan',{method:'POST'}); const d=await r.json();
    if(d.error) throw d.error;
    curPlanId=d.id; renderPlan(d); loadPlanHistory();
  }catch(e){ $('#planStatus').textContent='Hata: '+e; }
  btn.disabled=false; btn.textContent=old; planLoading=false;
}
async function loadPlanHistory(){
  try{
    const r=await fetch('/api/plan/history'); const d=await r.json();
    const runs=d.runs||[];
    $('#planHistory').innerHTML = runs.length ? runs.map(x=>`
      <div class="h ${x.id===curPlanId?'on':''}" onclick="showPlanRun('${x.id}')">
        <div class="del" title="Sil" onclick="delPlanRun(event,'${x.id}')">×</div>
        <div class="t">${(x.ts_tr||x.id).slice(5)}</div>
        <div class="m">${x.count} aday · ${(x.symbols||[]).map(s=>s.replace('USDT','')).join(', ')||'—'}</div>
      </div>`).join('') : '<div class="muted" style="font-size:12px">Henüz kayıt yok</div>';
  }catch(e){}
}
async function delPlanRun(ev,id){
  ev.stopPropagation();
  try{
    await fetch('/api/plan/delete',{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify({id})});
    if(id===curPlanId){ curPlanId=null;
      $('#planRows').innerHTML='<tr><td colspan="9" class="muted">Tarama silindi — <b>Tara</b>\'ya bas veya geçmişten seç.</td></tr>';
      $('#planStatus').innerHTML='';
    }
    loadPlanHistory();
  }catch(e){}
}
async function showPlanRun(id){
  try{
    const r=await fetch('/api/plan/run?id='+encodeURIComponent(id)); const d=await r.json();
    if(d.error) return;
    curPlanId=id; renderPlan(d); loadPlanHistory();
  }catch(e){}
}

/* ═══ Plan "en iyi giriş" · canlı 1dk retest alarmı ═══ */
async function armPlan(sym){
  const c=planCands[sym]; if(!c) return;
  const b=$('#arm-'+sym); if(b){b.disabled=true;b.textContent='⏳';}
  try{
    await fetch('/api/plan/arm',{method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({symbol:sym, side:c.side,
        level:c.res1!=null?c.res1:c.sup1, entry:c.entry, stop:c.stop,
        tp1:c.tp1, tp2:c.tp2})});
    pollArmed();
  }catch(e){}
  if(b){b.disabled=false;b.textContent='🔔 İzle';}
}
async function disarmPlan(sym){
  try{ await fetch('/api/plan/disarm',{method:'POST',
    headers:{'Content-Type':'application/json'},body:JSON.stringify({symbol:sym})});
  }catch(e){}
  pollArmed();
}
const PRW_PH={wait_break:['⏳','Kırılım bekleniyor'],
  wait_retest:['👀','Retest bekleniyor'], fired:['🎯','ŞİMDİ GİR'],
  expired:['✖︎','Sinyal yok'], cancel:['—','Durduruldu'], error:['⚠️','Hata']};
async function pollArmed(){
  try{
    const r=await fetch('/api/plan/armed'); const d=await r.json();
    const ws=d.watchers||[];
    const el=$('#planArmed'); if(!el) return;
    if(!ws.length){ el.innerHTML=''; return; }
    el.innerHTML='<div class="col-h" style="margin:2px 0 6px">🔔 Retest izlenenler</div>'+
      ws.map(w=>{
        const ph=PRW_PH[w.phase]||['•',w.phase];
        const cls=w.phase==='fired'?'armw fire':(w.phase==='expired'||w.phase==='cancel'||w.phase==='error'?'armw off':'armw');
        return `<div class="${cls}">
          <span class="s">${w.symbol.replace('USDT','')}</span>
          <span class="p">${ph[0]} ${w.message||ph[1]}</span>
          ${w.touched&&w.phase==='wait_retest'?'<span class="tag">dokundu</span>':''}
          <span class="x" title="Durdur" onclick="disarmPlan('${w.symbol}')">×</span>
        </div>`;
      }).join('');
  }catch(e){}
}
poll(pollArmed, 5000);

/* ═══ Retest Dönüş · kırdı+retest+yukarı hazır fırsatlar ═══ */
let retestLoading=false;
function retestRow(c,i){
  const chart=`https://futures.mexc.com/exchange/${c.symbol.replace(/USDT$/,'_USDT')}`;
  return `<tr onclick="openMexc('${chart}')" style="cursor:pointer">
    <td class="muted">${i+1}</td>
    <td><span class="sym">${c.symbol.replace('USDT','')}</span></td>
    <td><span class="lv">${fnum(c.price)}</span></td>
    <td><span class="lv">${fnum(c.level)}</span> <span class="pct">+${c.dist_pct}%</span></td>
    <td><span class="lv">${fnum(c.entry)}</span></td>
    <td><span class="lv stp">${fnum(c.stop)}</span> <span class="pct">−${c.stop_pct}%</span></td>
    <td><span class="lv tgt">${fnum(c.tp1)}</span> <span class="pct">+${c.tp1_pct}%</span></td>
    <td><span class="lv tgt">${fnum(c.tp2)}</span> <span class="pct">+${c.tp2_pct}%</span></td>
    <td class="res">${c.bars_ago*5}dk önce kırdı
      <br>${c.retest_done?`<span class="tag ok">retest ✓ ${fnum(c.retest_low)}</span>`:'<span class="tag wait">retest bekliyor</span>'}
      ${c.rising?'<span class="tag up">↑ yukarı</span>':''}
      <br><span class="muted">hacim ${c.vol_mult}x</span></td>
  </tr>`;
}
function renderRetest(d){
  const cs=d.candidates||[];
  $('#retestRows').innerHTML = cs.length
    ? cs.map(retestRow).join('')
    : '<tr><td colspan="9" class="muted">Şu an paterni tamamlamış (kırdı+retest+yukarı) coin yok. Birazdan tekrar dener.</td></tr>';
  const when = d.ts? new Date(d.ts*1000).toLocaleTimeString('tr-TR'):'';
  $('#retestStatus').innerHTML =
    `<span class="stat-chip hi">${cs.length} coin kırdı</span>`+
    (when?`<span class="stat-chip">${when}</span>`:'')+
    (d.error?`<span class="stat-chip">Hata: ${d.error}</span>`:'');
  enter('#retestRows tr');
}
async function loadRetest(){
  if(retestLoading) return; retestLoading=true;
  const btn=$('#retestBtn'); if(btn){btn.disabled=true;}
  $('#retestStatus').innerHTML='<span class="stat-chip">taranıyor, ~10 sn…</span>';
  try{
    const r=await fetch('/api/retest'); const d=await r.json();
    renderRetest(d);
  }catch(e){ $('#retestStatus').textContent='Hata: '+e; }
  if(btn){btn.disabled=false;}
  retestLoading=false;
}

/* ═══════════ short plan · destek / kırılım ═══════════ */
let splanLoading=false, curSPlanId=null;
function splanRow(c,i){
  return `<tr>
    <td class="muted">${i+1}</td>
    <td><span class="sym">${c.symbol.replace('USDT','')}</span></td>
    <td><span class="side sh">🔴 ${c.side}</span></td>
    <td><span class="lv">${fnum(c.entry)}</span></td>
    <td><span class="lv stp">${fnum(c.stop)}</span> <span class="pct">+${c.stop_pct}%</span></td>
    <td><span class="lv tgt">${fnum(c.tp1)}</span> <span class="pct">−${c.tp1_pct}%</span></td>
    <td><span class="lv tgt">${fnum(c.tp2)}</span> <span class="pct">−${c.tp2_pct}%</span></td>
    <td class="res">D1 ${fnum(c.sup1)}<br>D2 ${fnum(c.sup2)}<br><span class="muted">Dir ${fnum(c.resistance)}</span></td>
  </tr>`;
}
function renderSPlan(d){
  const cs=d.candidates||[];
  $('#splanRows').innerHTML = cs.length
    ? cs.map(splanRow).join('')
    : '<tr><td colspan="8" class="muted">Şu an kritere uyan kırılım adayı yok. Sonra tekrar dene.</td></tr>';
  const when = d.ts_tr || (d.ts? new Date(d.ts*1000).toLocaleString('tr-TR'):'');
  $('#splanStatus').innerHTML =
    `<span class="stat-chip hi">${cs.length} aday</span>`+
    (when?`<span class="stat-chip">${when}</span>`:'');
  enter('#splanRows tr');
}
async function runSPlan(){
  if(splanLoading) return; splanLoading=true;
  const btn=$('#splanScanBtn'); btn.disabled=true; const old=btn.textContent;
  btn.textContent='⏳ Taranıyor…';
  $('#splanStatus').innerHTML='<span class="stat-chip">piyasa taranıyor, ~10 sn…</span>';
  try{
    const r=await fetch('/api/splan/scan',{method:'POST'}); const d=await r.json();
    if(d.error) throw d.error;
    curSPlanId=d.id; renderSPlan(d); loadSPlanHistory();
  }catch(e){ $('#splanStatus').textContent='Hata: '+e; }
  btn.disabled=false; btn.textContent=old; splanLoading=false;
}
async function loadSPlanHistory(){
  try{
    const r=await fetch('/api/splan/history'); const d=await r.json();
    const runs=d.runs||[];
    $('#splanHistory').innerHTML = runs.length ? runs.map(x=>`
      <div class="h ${x.id===curSPlanId?'on':''}" onclick="showSPlanRun('${x.id}')">
        <div class="del" title="Sil" onclick="delSPlanRun(event,'${x.id}')">×</div>
        <div class="t">${(x.ts_tr||x.id).slice(5)}</div>
        <div class="m">${x.count} aday · ${(x.symbols||[]).map(s=>s.replace('USDT','')).join(', ')||'—'}</div>
      </div>`).join('') : '<div class="muted" style="font-size:12px">Henüz kayıt yok</div>';
  }catch(e){}
}
async function delSPlanRun(ev,id){
  ev.stopPropagation();
  try{
    await fetch('/api/splan/delete',{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify({id})});
    if(id===curSPlanId){ curSPlanId=null;
      $('#splanRows').innerHTML='<tr><td colspan="8" class="muted">Tarama silindi — <b>Tara</b>\'ya bas veya geçmişten seç.</td></tr>';
      $('#splanStatus').innerHTML='';
    }
    loadSPlanHistory();
  }catch(e){}
}
async function showSPlanRun(id){
  try{
    const r=await fetch('/api/splan/run?id='+encodeURIComponent(id)); const d=await r.json();
    if(d.error) return;
    curSPlanId=id; renderSPlan(d); loadSPlanHistory();
  }catch(e){}
}

/* ═══════════ stochrsi canlı sinyal ═══════════ */
let SIG_COINS = [];
let SIG_FOCUS = null;
let SIG_REC = {};            // coin -> {rec:'AL'|'SAT', src:'sekme adı'} (geldiği sekmenin önerisi)
let sigLoading = false;
try{ SIG_COINS = JSON.parse(localStorage.getItem('sigCoins')||'[]'); }catch(e){ SIG_COINS=[]; }
try{ SIG_REC = JSON.parse(localStorage.getItem('sigRec')||'{}'); }catch(e){ SIG_REC={}; }
function saveSigCoins(){ try{ localStorage.setItem('sigCoins', JSON.stringify(SIG_COINS)); }catch(e){} }
function saveSigRec(){ try{ localStorage.setItem('sigRec', JSON.stringify(SIG_REC)); }catch(e){} }
function normCoin(s){
  return (s||'').trim().toUpperCase().replace(/[^A-Z0-9]/g,'').replace(/USDT$/,'');
}
function renderSigChips(){
  const el=$('#sigChips'); if(!el) return;
  el.innerHTML = SIG_COINS.length
    ? SIG_COINS.map(c=>`<span class="sig-chip">${c}<span class="x" title="çıkar"
        onclick="removeSigCoin('${c}')">×</span></span>`).join('')
    : '<span class="muted" style="font-size:12px">Henüz coin yok — yukarıdan ekle ya da başka sekmedeki kartta “📈 Sinyal İzle”ye bas.</span>';
}
function addSigCoins(){
  const inp=$('#sigInput'); if(!inp) return;
  inp.value.split(/[,\s]+/).map(normCoin).filter(Boolean).forEach(c=>{
    if(!SIG_COINS.includes(c)) SIG_COINS.push(c);
  });
  inp.value=''; saveSigCoins(); renderSigChips(); loadSignals();
}
function removeSigCoin(c){
  SIG_COINS = SIG_COINS.filter(x=>x!==c);
  if(SIG_FOCUS===c) SIG_FOCUS=null;
  delete SIG_REC[c];
  saveSigCoins(); saveSigRec(); renderSigChips(); loadSignals();
}
/* başka sekmedeki karttan çağrılır: ekle + o sekmenin önerisini sakla + geç + odakla */
function watchSignal(sym, rec, src){
  const c=normCoin(sym); if(!c) return;
  if(!SIG_COINS.includes(c)) SIG_COINS.push(c);
  if(rec) SIG_REC[c]={rec:rec, src:src||''};
  SIG_FOCUS=c; saveSigCoins(); saveSigRec();
  selectTab('signal');
}
let sigTf='15';
/* izleme kartı — coin EMA50+StochRSI kurulumunu tuttuğunda gösterilir */
function sigWatchCard(r){
  const s=r.symbol.replace(/USDT$/,'');
  const focus = normCoin(r.symbol)===SIG_FOCUS;
  const isL=r.side==='LONG';
  const tag=isL?['sq-fresh','🟢 AL']:['sq-late','🔴 SHORT'];
  const cls=n=>n<0?'neg':'pos';
  const pf=n=>{ if(n==null) return '—'; n=+n; return n>=1?n.toLocaleString('en-US',{maximumFractionDigits:6})
                                 :n.toPrecision(4); };
  const mexc=r.symbol.replace(/USDT$/,'_USDT');
  const url=`https://futures.mexc.com/exchange/${mexc}`
    +`#ft_amt=5&ft_tp=${r.tp1}&ft_cls=80&ft_side=${isL?'long':'short'}`;
  const kcol=r.k<30?'#2fe08a':r.k>70?'#ff5470':'#a9b6d6';
  const crossBadge = r.cross!=='none'
    ? `<span class="sq-tag sq-fresh" style="background:rgba(47,224,138,.14);color:#2fe08a">✚ Kesişim</span>` : '';
  const tfLbl = sigTf==='240'?'4sa':sigTf==='60'?'1sa':sigTf+'dk';
  return `<div class="sq-card ${focus?'focus':''}" onclick="openMexc('${url}')">
    <div class="sq-top"><span class="sq-sym">${s}</span><span class="sq-tr">${crossBadge}<button class="watchbtn" onclick="event.stopPropagation();removeSigCoin('${normCoin(r.symbol)}')">✕ İzlemeden çıkar</button><span class="sq-tag ${tag[0]}">${tag[1]}</span></span></div>
    <div class="sq-rows">
      <span class="k">Fiyat</span><span class="v">${pf(r.price)}</span>
      <span class="k">EMA50</span><span class="v">${pf(r.ema50)}</span>
      <span class="k">EMA'ya uzaklık</span><span class="v ${cls(r.dist_ema)}">${r.dist_ema>0?'+':''}${r.dist_ema}%</span>
      <span class="k">StochRSI %K</span><span class="v" style="color:${kcol};font-weight:800">${r.k}</span>
      <span class="k">StochRSI %D</span><span class="v">${r.d}</span>
      <span class="k">RSI(14)</span><span class="v">${r.rsi}</span>
      ${r.adx!=null?`<span class="k">ADX (trend gücü)</span><span class="v" style="color:${r.adx>=28?'#2fe08a':r.adx>=22?'#f5c451':'#a9b6d6'};font-weight:800">${r.adx}${r.adx>=28?' güçlü':''}</span>`:''}
    </div>
    <div class="tr-plan">
      <span class="k">Giriş</span><span class="v">${pf(r.entry)}</span>
      <span class="k">Stop</span><span class="v stp">${pf(r.stop)} · -${r.stop_pct}%</span>
      <span class="k">Hedef 1</span><span class="v tgt">${pf(r.tp1)} · +${r.tp1_pct}%</span>
      <span class="k">Hedef 2</span><span class="v tgt">${pf(r.tp2)} · +${r.tp2_pct}%</span>
    </div>
    <div class="sq-foot">skor ${r.score} · ${tfLbl} grafik · EMA50 + StochRSI kurulumu tutuyor</div>
  </div>`;
}
async function loadSignals(){
  if(sigLoading) return;
  renderSigChips();
  if(!SIG_COINS.length){
    $('#sigGrid').innerHTML='';
    $('#sigStatus').innerHTML='';
    return;
  }
  sigLoading=true;
  $('#sigStatus').innerHTML='<span class="spinner"></span> İzleme listesi EMA50 + StochRSI kurulumuna karşı denetleniyor…';
  try{
    const r=await (await fetch('/api/signal_watch?tf='+sigTf+'&symbols='+encodeURIComponent(SIG_COINS.join(',')))).json();
    const rows=r.candidates||[];
    // odaklanan öne gelsin (zaten skora göre sıralı)
    rows.sort((a,b)=>{
      const fa=(normCoin(a.symbol)===SIG_FOCUS)?0:1, fb=(normCoin(b.symbol)===SIG_FOCUS)?0:1;
      return fa-fb;
    });
    $('#sigGrid').innerHTML = rows.length ? rows.map(sigWatchCard).join('')
      : `<div class="muted" style="padding:30px">İzlemedeki <b>${r.watched||SIG_COINS.length}</b> coinden hiçbiri şu an EMA50 + StochRSI kurulumunu tutmuyor — kurulum oluşunca burada AL/SHORT kartı otomatik çıkar. İzlemeye devam.</div>`;
    $('#sigStatus').innerHTML = r.error ? ('Hata: '+r.error)
      : `<span class="stat-chip hi">${r.watched||SIG_COINS.length} izlemede</span>`+
        `<span class="stat-chip" style="color:var(--acc)">🎯 ${r.count} kurulum tutuyor</span>`+
        `<span class="stat-chip" style="color:var(--grn)">🟢 ${r.longs||0} AL</span>`+
        `<span class="stat-chip" style="color:var(--red)">🔴 ${r.shorts||0} SHORT</span>`+
        `<span class="stat-chip">${new Date((r.ts||Date.now()/1000)*1000).toLocaleTimeString('tr-TR')}</span>`;
  }catch(e){ $('#sigStatus').textContent='Hata: '+e; }
  sigLoading=false;
}
document.querySelectorAll('.sig-tf').forEach(b=>{
  b.addEventListener('click',()=>{
    sigTf=b.dataset.tf;
    document.querySelectorAll('.sig-tf').forEach(x=>x.classList.toggle('on',x===b));
    loadSignals();
  });
});

/* ═══════════ sekmeler ═══════════ */
let curTab='funding';
function moveInd(el){
  const ind=$('#tabInd'); if(!ind||!el) return;
  ind.style.left = el.offsetLeft+'px';
  ind.style.width = el.offsetWidth+'px';
}
function selectTab(name){
  curTab=name;
  document.querySelectorAll('.tab').forEach(t=>{
    const on=t.dataset.tab===name; t.classList.toggle('on',on);
    if(on) moveInd(t);
  });
  document.querySelectorAll('.tab-panel').forEach(p=>{
    p.classList.toggle('on', p.id==='tab-'+name);
  });
  if(name==='funding') loadFunding();
  if(name==='signal') loadSignals();
  if(name==='emastoch') loadEmaStoch();
  if(name==='dipzirve') loadDipZirve();
  if(name==='sr') loadSR();
  if(name==='dzlog') loadDzLog();
  if(name==='bot') loadBotTrades();
  if(name==='trend') loadTrend();
  if(name==='protrend') loadProTrend();
  if(name==='scalp') loadScalp();
  if(name==='squeeze') loadSqueeze();
  if(name==='pump') loadPump();
  if(name==='plan') loadPlanHistory();
  if(name==='retest') loadRetest();
  if(name==='splan') loadSPlanHistory();
}
document.querySelectorAll('.tab').forEach(t=>{
  t.addEventListener('click',()=>selectTab(t.dataset.tab));
});
// gösterge başlangıç konumu + pencere yeniden boyutlanınca
setTimeout(()=>moveInd(document.querySelector('.tab.on')), 60);
window.addEventListener('resize',()=>moveInd(document.querySelector('.tab.on')));

/* ═══════════ ana döngü ═══════════ */
loadFunding(); poll(loadFunding, 20000);  // funding tablosunu canlı tut
poll(()=>{ if(curTab==='signal') loadSignals(); }, 7000); // stochrsi sinyal canlı
poll(()=>{ if(curTab==='emastoch') loadEmaStoch(); }, 30000); // ema50+stochrsi tarayıcı canlı
poll(()=>{ if(curTab==='dipzirve') loadDipZirve(); }, 30000); // dip/zirve confluence canlı
poll(()=>{ if(curTab==='sr') loadSR(); }, 30000); // destek/direnç canlı
poll(()=>{ if(curTab==='dzlog') loadDzLog(); }, 60000); // dip/zirve geçmiş defteri canlı
poll(()=>{ loadBotTrades(); }, 10000); // bot işlemleri canlı (10sn) — hangi sekmede olursak olalım yeni işlemde sesli bildirim
poll(()=>{ if(curTab==='squeeze') loadSqueeze(); }, 60000); // squeeze adayları canlı
poll(()=>{ if(curTab==='pump') loadPump(); }, 60000); // patlamış adaylar canlı
poll(()=>{ if(curTab==='trend') loadTrend(); }, 30000); // trend scalp canlı
poll(()=>{ if(curTab==='protrend') loadProTrend(); }, 25000); // pro trend (1dk) canlı
poll(()=>{ if(curTab==='scalp') loadScalp(); }, 20000); // 1dk scalp canlı
poll(()=>{ if(curTab==='retest') loadRetest(); }, 45000); // retest dönüş canlı
tickClock();
</script>
</body>
</html>
